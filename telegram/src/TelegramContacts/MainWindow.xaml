<Window x:Class="TelegramContacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TelegramContacts.ViewModels"
        Title="TG Contacts Manager — إدارة جهات اتصال تلجرام"
        Width="1040" Height="680" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Margin="0,0,0,18">
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentBrush}" Margin="0,0,0,0">
                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" />
            </Border>
            <StackPanel Margin="12,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource H1}" Text="جهات اتصال تلجرام" />
                <TextBlock Style="{StaticResource Muted}" Text="إضافة · تعديل · حذف — من حسابك مباشرة" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding MeText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="تحديث" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="تسجيل الخروج" Command="{Binding LogoutCommand}" Style="{StaticResource DangerButton}" />
            </StackPanel>
        </DockPanel>

        <!-- login page -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Width="440" VerticalAlignment="Center"
                Visibility="{Binding IsLoggedOut, Converter={StaticResource Vis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H3}" Text="تسجيل الدخول إلى تلجرام" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="احصل على api_id و api_hash من my.telegram.org ← API development tools" />

                <StackPanel IsEnabled="{Binding IsAskingValue, Converter={x:Static vm:Inverse.Instance}}">
                    <TextBlock Style="{StaticResource Label}" Text="api_id" />
                    <TextBox Style="{StaticResource LtrBox}" Text="{Binding ApiId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Label}" Text="api_hash" />
                    <TextBox Style="{StaticResource LtrBox}" Text="{Binding ApiHash, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Label}" Text="رقم الهاتف (مع رمز الدولة)" />
                    <TextBox Style="{StaticResource LtrBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsAskingValue, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Label}" Text="{Binding StepPrompt}" Foreground="{StaticResource BlueBrush}" />
                    <TextBox Style="{StaticResource LtrBox}" Text="{Binding LoginValue, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsTextStep, Converter={StaticResource Vis}}" />
                    <PasswordBox x:Name="Password" FlowDirection="LeftToRight" Padding="10,8" FontSize="13.5"
                                 Background="{StaticResource InputBrush}" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource TextBrush}"
                                 PasswordChanged="OnPasswordChanged"
                                 Visibility="{Binding IsPasswordStep, Converter={StaticResource Vis}}" />
                </StackPanel>

                <Button Content="{Binding LoginButtonText}" Command="{Binding LoginCommand}" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Padding="16,10" />
            </StackPanel>
        </Border>

        <!-- contacts page -->
        <Grid Grid.Row="1" Visibility="{Binding IsLoggedIn, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource H3}" VerticalAlignment="Center">
                            <Run Text="جهات الاتصال" /> <Run Text="{Binding Count, Mode=OneWay}" Foreground="{StaticResource BlueBrush}" />
                        </TextBlock>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Right"
                                 ToolTip="بحث بالاسم أو الرقم أو اسم المستخدم" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding ContactsView}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentBrush}">
                                        <TextBlock Text="{Binding FirstName[0], FallbackValue=?}" Foreground="White" FontWeight="Bold"
                                                   FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Phone, StringFormat=+{0}}" FlowDirection="LeftToRight"
                                               Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Username, StringFormat=@{0}}" Style="{StaticResource Muted}"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="{Binding FormTitle}" />
                    <TextBlock Style="{StaticResource Label}" Text="الاسم الأول" />
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Label}" Text="اسم العائلة" />
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Label}" Text="رقم الهاتف (مع رمز الدولة)" />
                    <TextBox Style="{StaticResource LtrBox}" Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsEditing}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5"
                               Text="عند التعديل يتغير الاسم فقط؛ تلجرام لا يسمح بتغيير رقم جهة اتصال موجودة."
                               Visibility="{Binding IsEditing, Converter={StaticResource Vis}}" />

                    <Button Content="➕  إضافة جديدة" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                            Visibility="{Binding IsEditing, Converter={x:Static vm:InverseVis.Instance}}" />
                    <UniformGrid Columns="2" Margin="0,18,0,0" Visibility="{Binding IsEditing, Converter={StaticResource Vis}}">
                        <Button Content="حفظ التعديل" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,0" />
                        <Button Content="حذف" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                    </UniformGrid>
                    <Button Content="جهة اتصال جديدة" Command="{Binding NewCommand}" Margin="0,8,0,0"
                            Visibility="{Binding IsEditing, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- status bar -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <ProgressBar Width="120" Height="4" IsIndeterminate="{Binding IsBusy}" BorderThickness="0"
                         Background="{StaticResource BorderBrush}" Foreground="{StaticResource BlueBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" Margin="0,0,10,0" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" />
        </DockPanel>
    </Grid>
</Window>
