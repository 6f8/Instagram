<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- only for the notification-area icon (NotifyIcon); WinForms namespaces are not imported globally -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- allows building the Windows-only project from Linux/macOS as well -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InstagramStoryViewer.Gui</RootNamespace>
    <AssemblyName>InstagramStoryViewer</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.3.2</Version>
    <Product>IG Story Viewer Pro</Product>
    <!-- File metadata shown in Explorer's Properties; unsigned binaries without it look more suspicious to AV/SmartScreen. -->
    <Company>IG Story Viewer Pro</Company>
    <Description>Instagram story viewer and downloader for Windows</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 → single self-contained .exe (no .NET install needed) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- explicit RID: a self-contained build otherwise targets the build machine (fails on Linux/macOS) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../InstagramStoryViewer.Core/InstagramStoryViewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Fonts\*.otf" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
