<Window x:Class="InstagramStoryViewer.Gui.Views.FullscreenViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عرض الستوري"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual" Topmost="True"
        ShowInTaskbar="False"
        Background="Black"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        Foreground="White"
        KeyDown="OnKeyDown">
    <Grid>
        <!-- media (click: start half = previous, end half = next, like Instagram in RTL) -->
        <Grid x:Name="Stage" FlowDirection="LeftToRight" Background="Black" MouseLeftButtonUp="Stage_Click" Cursor="Hand">
            <Image x:Name="Photo" Stretch="Uniform" />
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                          MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed" />
            <Border x:Name="PausedBadge" Width="72" Height="72" CornerRadius="36" Background="#88000000" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE034;" FontSize="34" Foreground="White" />
            </Border>
            <TextBlock x:Name="LoadingText" Text="جاري التحميل..." FlowDirection="RightToLeft" Foreground="#AAFFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,90" Visibility="Collapsed" />
        </Grid>

        <!-- top: segments + header -->
        <StackPanel VerticalAlignment="Top" Margin="24,14,24,0">
            <UniformGrid x:Name="Segments" Rows="1" Height="3" />
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Background="#66000000" BorderThickness="0"
                        Click="Close_Click" ToolTip="إغلاق (Esc)">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE5CD;" Foreground="White" />
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" FontSize="16" FontWeight="Bold" />
                    <TextBlock x:Name="MetaText" FontSize="13" Foreground="#BBFFFFFF" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- side arrows -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0" Width="52" Height="52"
                Style="{StaticResource IconButton}" Background="#44FFFFFF" BorderThickness="0" Click="Prev_Click" ToolTip="السابق">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE5CB;" FontSize="28" Foreground="White" />
        </Button>
        <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0" Width="52" Height="52"
                Style="{StaticResource IconButton}" Background="#44FFFFFF" BorderThickness="0" Click="Next_Click" ToolTip="التالي">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE5CC;" FontSize="28" Foreground="White" />
        </Button>

        <!-- bottom: actions + keyboard hints -->
        <DockPanel VerticalAlignment="Bottom" Margin="24,0,24,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource DarkOverlayButton}" Click="Seen_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="مشاهَد" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Download_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xF090;" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="تنزيل (D)" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- keyboard hints; arrows come from the icon font (Cairo has no arrow glyphs): ← next, → previous -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.Foreground="#88FFFFFF" TextElement.FontSize="12">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE5C4;" FontSize="13" Foreground="#88FFFFFF" />
                <TextBlock Text=" التالي     " />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE5C8;" FontSize="13" Foreground="#88FFFFFF" />
                <TextBlock Text=" السابق     مسافة: إيقاف مؤقت     D: تنزيل     Esc: إغلاق" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
