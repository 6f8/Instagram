<UserControl x:Class="InstagramStoryViewer.Gui.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InstagramStoryViewer.Gui.ViewModels">
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding OpenLogsFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEF42;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="سجل التشغيل" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding ClearHistoryCommand}" Foreground="{StaticResource RedBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE872;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="مسح السجل" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="سجل المشاهدات" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                           Text="كل ستوري شاهده البرنامج نيابةً عنك، وهل أكّد إنستجرام تسجيل المشاهدة." />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,10,16,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="8,4,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="الوقت" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="1" Text="الحساب" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="2" Text="الطريقة" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="3" Text="النتيجة" Style="{StaticResource ColHeader}" />
                </Grid>
                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                         ItemsSource="{Binding History}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WatchRecordViewModel}">
                            <Grid Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding Detail}">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                                    <!-- comments: the text that was posted -->
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ModeText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding ResultText}" VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Verified">
                                                    <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Shown">
                                                    <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="فتح في المتصفح"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding StoryUrl}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE89E;" FontSize="13" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding History.Count, Converter={StaticResource NotVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE889;" FontSize="44" Foreground="#2A2F45" />
                    <TextBlock Text="لم يشاهد البرنامج أي ستوري بعد" Style="{StaticResource Muted}" FontSize="14" Margin="0,14,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
