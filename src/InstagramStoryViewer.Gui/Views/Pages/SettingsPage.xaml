<UserControl x:Class="InstagramStoryViewer.Gui.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InstagramStoryViewer.Gui.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18,14,18,16" MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock Text="الإعدادات" Style="{StaticResource H1}" Margin="0,0,0,18" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="20,18">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding LogoutCommand}" VerticalAlignment="Center"
                        Foreground="{StaticResource RedBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9BA;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="تسجيل الخروج" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="الحساب" Style="{StaticResource H3}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding SessionText}" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                        <TextBlock Text="  ·  معرّف المستخدم: " Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ViewerId}" Style="{StaticResource Muted}" FlowDirection="LeftToRight" />
                    </StackPanel>
                    <TextBlock Text="الجلسة محفوظة مشفّرة على هذا الجهاز ولا يمكن قراءتها من حساب ويندوز آخر."
                               Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="20,18">
            <StackPanel>
                <TextBlock Text="مجلد التنزيل" Style="{StaticResource H3}" />
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding OpenDownloadFolderCommand}" Content="فتح" />
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding BrowseFolderCommand}" Content="تغيير..." />
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding DownloadFolder, Mode=OneWay}" IsReadOnly="True"
                             FlowDirection="LeftToRight" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="20,18">
            <StackPanel>
                <TextBlock Text="السلوك" Style="{StaticResource H3}" Margin="0,0,0,12" />
                <CheckBox IsChecked="{Binding ConfirmBeforeMarkSeen}" Content="اسأل قبل تعليم الستوري كمشاهَد (لأن اسمك سيظهر لصاحبه)" />
                <CheckBox IsChecked="{Binding AutoPlayVideos}" Content="تشغيل الفيديو تلقائياً في المعاينة" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="20,18">
            <StackPanel>
                <TextBlock Text="المشاهدة التلقائية" Style="{StaticResource H3}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="تُعرض الستوريات في نافذة صغيرة بزاوية الشاشة لثوانٍ فيسجّلها إنستجرام كمشاهَدة. سيظهر اسمك لأصحابها." />
                <CheckBox IsChecked="{Binding AutoWatchOnPreview}" Content="شاهِد الستوري تلقائياً عند معاينته (بعد ثانيتين)" />
                <CheckBox IsChecked="{Binding AutoWatchNew}" Content="شاهِد الستوريات الجديدة لمن أتابعهم في الخلفية" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="الحد اليومي:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Style="{StaticResource Chip}" Content="100" GroupName="dailyLimit"
                                 IsChecked="{Binding AutoWatchDailyLimit, Converter={StaticResource ValueBool}, ConverterParameter=100}" />
                    <RadioButton Style="{StaticResource Chip}" Content="200" GroupName="dailyLimit"
                                 IsChecked="{Binding AutoWatchDailyLimit, Converter={StaticResource ValueBool}, ConverterParameter=200}" />
                    <RadioButton Style="{StaticResource Chip}" Content="400" GroupName="dailyLimit"
                                 IsChecked="{Binding AutoWatchDailyLimit, Converter={StaticResource ValueBool}, ConverterParameter=400}" />
                </StackPanel>
                <TextBlock Text="{Binding AutoWatchStatus}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="20,18">
            <StackPanel>
                <TextBlock Text="حماية الحساب" Style="{StaticResource H3}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="حد أقصى لطلبات إنستجرام في الساعة. الحد الأقل أكثر أماناً لحسابك. التحديث التلقائي يتوقف عند تصغير البرنامج." />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="طلبات في الساعة:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Style="{StaticResource Chip}" Content="120" GroupName="rate"
                                 IsChecked="{Binding MaxRequestsPerHour, Converter={StaticResource ValueBool}, ConverterParameter=120}" />
                    <RadioButton Style="{StaticResource Chip}" Content="180" GroupName="rate"
                                 IsChecked="{Binding MaxRequestsPerHour, Converter={StaticResource ValueBool}, ConverterParameter=180}" />
                    <RadioButton Style="{StaticResource Chip}" Content="300" GroupName="rate"
                                 IsChecked="{Binding MaxRequestsPerHour, Converter={StaticResource ValueBool}, ConverterParameter=300}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0">
                    <Run Text="الطلبات في آخر ساعة: " /><Run Text="{Binding RequestsLastHour, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="حول البرنامج" Style="{StaticResource H3}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                    <Run Text="IG Story Viewer Pro · الإصدار " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="يعتمد البرنامج على واجهات إنستجرام غير الرسمية وقد تتغير دون إشعار. استخدمه للاستخدام الشخصي واحترم خصوصية الآخرين." />
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>
</UserControl>
