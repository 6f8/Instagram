<UserControl x:Class="InstagramStoryViewer.Gui.Views.Pages.FollowingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InstagramStoryViewer.Gui.ViewModels">
    <UserControl.Resources>
        <!-- small round toggle shown on a tile corner -->
        <Style x:Key="TileToggle" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#CC0D0F17" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding RefreshTrayCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE5D5;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="تحديث" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="من تتابعهم" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                    <Run Text="{Binding AccountsWithStories, Mode=OneWay}" /><Run Text=" حساب لديه ستوريات · " /><Run Text="{Binding UnseenAccounts, Mode=OneWay}" /><Run Text=" بستوريات جديدة" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- search + filter -->
        <!-- watch by topic: public accounts posting under a hashtag -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding WatchTopicCommand}" Padding="14,0" Height="36" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE037;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="شاهد ستوري الموضوع" />
                    </StackPanel>
                </Button>
                <TextBox DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Tag="موضوع أو هاشتاك، مثل برمجة" Width="260"
                         Text="{Binding TopicTag, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="مشاهدة حسب الموضوع" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="{Binding TopicStatus, TargetNullValue='يعرض ستوري حسابات عامة تنشر في هذا الهاشتاك، دون متابعتها ودون لايك.'}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Chip}" Content="الكل" GroupName="followFilter"
                             IsChecked="{Binding FollowingFilterMode, Converter={StaticResource ValueBool}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource Chip}" Content="الجديدة" GroupName="followFilter"
                             IsChecked="{Binding FollowingFilterMode, Converter={StaticResource ValueBool}, ConverterParameter=New}" />
                <RadioButton Style="{StaticResource Chip}" GroupName="followFilter"
                             IsChecked="{Binding FollowingFilterMode, Converter={StaticResource ValueBool}, ConverterParameter=Favorites}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Text="المفضّلة" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <TextBox Style="{StaticResource SearchBox}" Tag="ابحث بالاسم..." Width="300" HorizontalAlignment="Left"
                     Text="{Binding FollowingFilterText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FollowingView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TrayUserViewModel}">
                            <Grid Width="140" Margin="4">
                                <Button Style="{StaticResource RowButton}" Padding="8,12"
                                        Command="{Binding DataContext.OpenUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Width="120">
                                        <Viewbox Width="84" Height="84" HorizontalAlignment="Center">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Margin="0,8,0,0"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LatestText}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                                   TextAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- favorite (top start corner) -->
                                <Button Style="{StaticResource TileToggle}" HorizontalAlignment="Left"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock FontSize="15">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xE83A;" />
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Setter Property="ToolTip" Value="إضافة إلى المفضّلة" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Text" Value="&#xE838;" />
                                                        <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
                                                        <Setter Property="ToolTip" Value="إزالة من المفضّلة" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <!-- excluded from watching (top end corner) -->
                                <Button Style="{StaticResource TileToggle}" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.ToggleExcludedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xE8F5;" />
                                                <Setter Property="Foreground" Value="#3A3F55" />
                                                <Setter Property="ToolTip" Value="استثناء من المشاهدة التلقائية" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                        <Setter Property="ToolTip" Value="مستثنى من المشاهدة — اضغط لإلغاء الاستثناء" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
