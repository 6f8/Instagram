<UserControl x:Class="InstagramStoryViewer.Gui.Views.Pages.CommentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InstagramStoryViewer.Gui.ViewModels">
    <!-- DataContext: MainViewModel; the page works on its Comments view model. -->
    <Grid Margin="18,14,18,16" DataContext="{Binding Comments}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="تعليق على منشور" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="الصق رابط المنشور أو الريل، واكتب تعليقك، ثم اضغط نشر. يُكتب التعليق في خانة التعليق على صفحة المنشور نفسها في نافذة صغيرة، ويتحقق البرنامج من ظهوره." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14" Padding="20,18">
            <StackPanel>
                <TextBlock Text="رابط المنشور" FontWeight="SemiBold" Margin="0,0,0,6" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="38" Height="38" Margin="8,0,0,0"
                            ToolTip="فتح المنشور في المتصفح" Command="{Binding OpenPostCommand}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE89E;" FontSize="15" />
                    </Button>
                    <TextBox Style="{StaticResource FieldBox}" FlowDirection="LeftToRight" AutomationProperties.Name="رابط المنشور"
                             Text="{Binding PostUrl, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Text="{Binding LinkHint}" Foreground="{StaticResource OrangeBrush}" FontSize="12" Margin="2,6,0,0"
                           Visibility="{Binding HasLinkHint, Converter={StaticResource Vis}}" />

                <DockPanel Margin="0,16,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CharCountText}" Style="{StaticResource Muted}" FontSize="12"
                               FlowDirection="LeftToRight" />
                    <TextBlock Text="التعليق" FontWeight="SemiBold" />
                </DockPanel>
                <!-- RTL with automatic direction per paragraph: Arabic and English comments both read naturally -->
                <TextBox Style="{StaticResource FieldBox}" Height="110" Padding="10,8" VerticalContentAlignment="Top"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         MaxLength="2200" AutomationProperties.Name="نص التعليق"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding TextHint}" Foreground="{StaticResource OrangeBrush}" FontSize="12" Margin="2,6,0,0"
                           Visibility="{Binding HasTextHint, Converter={StaticResource Vis}}" />

                <DockPanel Margin="0,16,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="40" Padding="22,0"
                            Command="{Binding PostCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE163;" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="نشر التعليق" />
                        </StackPanel>
                    </Button>
                    <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="80" Height="4" Margin="0,0,14,0"
                                 Visibility="{Binding IsPosting, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,14,14,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="آخر التعليقات من البرنامج" Style="{StaticResource H3}" Margin="6,0,0,8" />
                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                         ItemsSource="{Binding Recent}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WatchRecordViewModel}">
                            <Grid MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding Detail}">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ResultText}" VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Verified">
                                                    <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Shown">
                                                    <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="فتح المنشور"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding StoryUrl}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE89E;" FontSize="13" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="لم تنشر أي تعليق من البرنامج بعد" Style="{StaticResource Muted}" FontSize="13.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Recent.IsEmpty, Converter={StaticResource Vis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
