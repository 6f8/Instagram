<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Cinemana.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="سينمانا | السينما بين يديك" Icon="{StaticResource CinemaMark}" Width="1450" Height="930" MinWidth="1000" MinHeight="690" Background="#090A0C" Foreground="#F5F5F6" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="{Binding TextSize}" WindowStartupLocation="CenterScreen">
<Window.InputBindings><KeyBinding Modifiers="Control" Key="R" Command="{Binding RefreshCommand}"/><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/></Window.InputBindings>
<Grid x:Name="RootLayout">
<Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="Sidebar" Background="#0D0E11" BorderBrush="#25262C" BorderThickness="1,0,0,0" Padding="17,25"><DockPanel>
<StackPanel DockPanel.Dock="Top">
<Image Source="{StaticResource CinemaMark}" Width="63" Height="42" HorizontalAlignment="Right" FlowDirection="LeftToRight" Margin="0,0,0,10"/>
<TextBlock Text="سينمانا" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
<TextBlock Text="C I N E M A N A" FontSize="10" Foreground="#797B85" Margin="0,3,0,23" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
<TextBox x:Name="SearchBox" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ابحث عن فيلم أو مسلسل" ToolTip="ابحث عن فيلم أو مسلسل • Ctrl+F" FontSize="12"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox>
<Button Content="بحث" Command="{Binding SearchCommand}" Margin="0,5,0,24" Padding="12,6"/>
<Button Content="⌂   الرئيسية" Style="{StaticResource NavButton}" Tag="movies" Command="{Binding NavigateCommand}" CommandParameter="movies"/>
<Button Content="▣   المسلسلات" Style="{StaticResource NavButton}" Tag="series" Command="{Binding NavigateCommand}" CommandParameter="series"/>
<Button Content="↓   التنزيلات" Style="{StaticResource NavButton}" Command="{Binding DownloadsCommand}"/>
<Border Height="1" Background="#28292F" Margin="4,22"/>
<Button Style="{StaticResource NavButton}" Tag="favorites" Command="{Binding NavigateCommand}" CommandParameter="favorites"><TextBlock><Run Text="♡   المفضلة  "/><Run Text="{Binding FavoriteCount,Mode=OneWay}"/></TextBlock></Button>
<Button Content="◷   سجل المشاهدة" Style="{StaticResource NavButton}" Tag="history" Command="{Binding NavigateCommand}" CommandParameter="history"/>
</StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Button Content="⚙   الإعدادات" Style="{StaticResource NavButton}" Command="{Binding SettingsCommand}"/><TextBlock Text="عميل مستقل لسينمانا" Foreground="#737680" FontSize="11" Margin="10,12,0,0"/></StackPanel><Border/>
</DockPanel></Border>
<Grid x:Name="LibraryPanel" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer x:Name="CatalogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border MinHeight="300" Background="#15161A" Visibility="{Binding HasHero,Converter={StaticResource BoolVisibility}}">
<Grid ClipToBounds="True" MinHeight="300">
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Image Grid.Column="1" Source="{Binding Hero.ImageSource}" Stretch="UniformToFill" Height="300" FlowDirection="LeftToRight"/>
<Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF090A0C" Offset="0"/><GradientStop Color="#F5090A0C" Offset="0.35"/><GradientStop Color="#50090A0C" Offset="0.68"/><GradientStop Color="#10090A0C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
<Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00090A0C" Offset="0.65"/><GradientStop Color="#FF090A0C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
<StackPanel Grid.ColumnSpan="2" Margin="30,20" HorizontalAlignment="Left" Width="{Binding HeroTextWidth,RelativeSource={RelativeSource AncestorType=Window}}">
<TextBlock Text="اكتشف • شاهد • احتفظ بما تحب" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,15"/>
<TextBlock Text="{Binding Hero.DisplayTitle}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="92" TextTrimming="CharacterEllipsis"/>
<TextBlock Text="{Binding Hero.Title}" Foreground="#999CA6" FontSize="13" Margin="0,7,0,10" TextTrimming="CharacterEllipsis"/>
<TextBlock Text="{Binding Hero.Caption}" Foreground="#E1C185" FontSize="14" Margin="0,0,0,8"/>
<TextBlock Text="{Binding Hero.Genres}" Foreground="#B9BBC3" TextTrimming="CharacterEllipsis"/>
<TextBlock Text="{Binding Hero.Description}" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" LineHeight="23" Foreground="#C9CAD1" Margin="0,12,0,13"/>
<WrapPanel><Button Content="▶   مشاهدة" Background="{StaticResource Accent}" Command="{Binding WatchCommand}" CommandParameter="{Binding Hero}" Padding="27,12" FontWeight="SemiBold"/><Button Content="↓   تحميل" Command="{Binding DownloadCommand}" CommandParameter="{Binding Hero}" Padding="24,12"/><Button Content="♡" Command="{Binding FavoriteCommand}" ToolTip="{Binding FavoriteLabel}" Padding="15,12"/><Button Content="التفاصيل والحلقات" Click="ToggleDetailsClick" FontSize="12" Padding="12"/></WrapPanel>
</StackPanel></Grid></Border>
<Border x:Name="DetailsPanel" Visibility="Collapsed" Background="#121317" BorderBrush="#292A30" BorderThickness="1" CornerRadius="12" Margin="25,0,25,20" Padding="20">
<ScrollViewer x:Name="DetailsScroll" MaxHeight="400" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" LineHeight="25" Margin="0,0,0,12"/>
<TextBlock Text="{Binding Selected.Language,StringFormat=اللغة: {0}}" Foreground="#A7AAB4"/>
<TextBlock Text="{Binding Selected.Director,StringFormat=الإخراج: {0}}" Foreground="#A7AAB4" Margin="0,5"/>
<TextBlock Text="{Binding Selected.Cast,StringFormat=التمثيل: {0}}" Foreground="#A7AAB4" TextWrapping="Wrap"/>
<TextBlock Text="{Binding Selected.DurationLabel}" Foreground="#A7AAB4" Margin="0,5"/>
<ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource Accent}" Visibility="{Binding DetailsBusy,Converter={StaticResource BoolVisibility}}"/>
<TextBlock Text="{Binding DetailsStatus}" Foreground="#E1C185" Margin="0,8"/>
                <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" AutomationProperties.Name="الموسم">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding StringFormat=الموسم {0}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                  <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Seasons.Count}" Value="0">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ComboBox.Style>
                </ComboBox>
                <ItemsControl ItemsSource="{Binding Episodes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel><Button Content="⬇" DockPanel.Dock="Left" Command="{Binding DataContext.DownloadCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="تنزيل هذه الحلقة"/><Button Content="{Binding EpisodeLabel}" Command="{Binding DataContext.WatchCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Right" /></DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

</StackPanel></ScrollViewer></Border>
<StackPanel Margin="25,12,25,12">
      <Border  Background="#18191E" Padding="18" CornerRadius="12" Margin="0,0,0,18" Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}">
        <WrapPanel VerticalAlignment="Center">
          <CheckBox Content="حفظ الصور محليًا لتسريع التصفح" IsChecked="{Binding CacheImages}" />
          <TextBlock Text="حجم البطاقات" VerticalAlignment="Center" Margin="22,0,8,0" />
          <Slider Width="100" Minimum="150" Maximum="220" Value="{Binding CardWidth}" VerticalAlignment="Center" />
          <TextBlock Text="حجم الخط" VerticalAlignment="Center" Margin="22,0,8,0" />
          <Slider Width="80" Minimum="12" Maximum="18" Value="{Binding TextSize}" VerticalAlignment="Center" />
          <TextBlock Text="تُحفظ التفضيلات تلقائيًا" Foreground="#A2B0C7" VerticalAlignment="Center" Margin="18,0" />
        </WrapPanel>
      </Border>

      <Grid  Margin="0,0,0,16">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold" />
        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
          <TextBlock Text="تصفية الصفحة:" VerticalAlignment="Center" Foreground="#8E9EB9" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" AutomationProperties.Name="التصنيف" />
          <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" AutomationProperties.Name="السنة" />
          <ComboBox SelectedIndex="{Binding RatingIndex}" AutomationProperties.Name="الحد الأدنى للتقييم">
            <ComboBoxItem Content="كل التقييمات" />
            <ComboBoxItem Content="6 فأعلى" />
            <ComboBoxItem Content="7 فأعلى" />
            <ComboBoxItem Content="8 فأعلى" />
          </ComboBox>
          <ComboBox SelectedIndex="{Binding SortIndex}" AutomationProperties.Name="الترتيب">
            <ComboBoxItem Content="ترتيب الخدمة" />
            <ComboBoxItem Content="الأعلى تقييمًا" />
            <ComboBoxItem Content="الأحدث سنةً" />
            <ComboBoxItem Content="الاسم" />
          </ComboBox>
          <Button Content="مسح الفلاتر" Command="{Binding ResetFiltersCommand}" Background="Transparent" Foreground="#A9B6CB" />
        </WrapPanel>
      </Grid>

<Grid><ItemsControl ItemsSource="{Binding Movies}" x:Name="Catalog"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate><DataTemplate>
<Border Width="{Binding DataContext.CardWidth,RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,13,18" BorderThickness="1" BorderBrush="#28292F" CornerRadius="10" Background="#111216"><StackPanel>
<Button Command="{Binding DataContext.SelectCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="0" Margin="0" Background="Transparent" AutomationProperties.Name="{Binding DisplayTitle}" ToolTip="{Binding DisplayTitle}">
<Grid><Border Height="235" Background="#1B1C22" CornerRadius="9" ClipToBounds="True"><Image Source="{Binding ImageSource}" Stretch="UniformToFill"/></Border><Border Background="#DA0B0C0F" CornerRadius="5" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Padding="7,3"><TextBlock Text="{Binding Rating,StringFormat=★ {0}}" Foreground="#F2D08A" FontSize="11" FlowDirection="LeftToRight"/></Border></Grid></Button>
<StackPanel Margin="11,10"><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="#858892" FontSize="11" FlowDirection="LeftToRight" Margin="0,4"/>
<DockPanel><Button Content="↓" DockPanel.Dock="Left" Padding="10,4" Margin="0" Command="{Binding DataContext.DownloadCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="تحميل واختيار الجودة"/><TextBlock Text="{Binding Year}" Foreground="#A6A8B2" VerticalAlignment="Center" FontSize="12"/><TextBlock Text="{Binding TypeLabel}" Foreground="#A6A8B2" VerticalAlignment="Center" FontSize="11" Margin="8,0"/></DockPanel>
<TextBlock Text="{Binding ProgressText}" Foreground="#ED9DA9" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel></Border>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Border Background="#EC090A0C" MinHeight="200" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"><StackPanel Width="220" HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource Accent}"/><TextBlock Text="نجهّز مكتبتك…" HorizontalAlignment="Center" Margin="0,18"/></StackPanel></Border>
<StackPanel MinHeight="180" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}"><TextBlock Text="لا توجد عناوين لعرضها" FontSize="22"/><TextBlock Text="جرّب بحثًا آخر أو امسح الفلاتر." Foreground="#A6A8B2" Margin="0,12"/><Button Content="إعادة المحاولة" Command="{Binding RefreshCommand}"/></StackPanel>
</Grid></StackPanel></StackPanel></ScrollViewer>
<Border x:Name="DownloadDock" Grid.Row="1" Margin="24,4" Padding="12" Background="#121317" BorderBrush="#28292F" BorderThickness="1" CornerRadius="10"><DockPanel>
<Button Content="قائمة التنزيلات  ←" DockPanel.Dock="Left" Click="OpenDownloadsClick" FontSize="12"/>
<StackPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding DockItem.Title}" Foreground="#D1D2D7" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3"/>
<ProgressBar Value="{Binding DockItem.Percent,Mode=OneWay,FallbackValue=0}" Height="3" Foreground="{StaticResource Accent}" Background="#303138" Margin="0,4"/>
<TextBlock Text="{Binding DockItem.ProgressLabel}" Foreground="#9396A1" FontSize="11" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
</StackPanel></DockPanel></Border>
<DockPanel Grid.Row="2" Margin="24,4,24,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="السابق" Command="{Binding PreviousCommand}" Padding="12,7"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="10,0" Foreground="#9598A2"/><Button Content="التالي" Command="{Binding NextCommand}" Padding="12,7"/></StackPanel><Button Content="↻" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" ToolTip="تحديث" Padding="12,7"/><TextBlock Text="{Binding Status}" Foreground="#82858F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" Margin="5,0"/></DockPanel>
</Grid><Border x:Name="PlayerHost" Grid.ColumnSpan="2" Panel.ZIndex="10" Background="#08090B" Visibility="Collapsed"/>
</Grid></Window>
