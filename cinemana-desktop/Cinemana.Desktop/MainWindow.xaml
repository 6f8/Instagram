<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Cinemana.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="سينمانا" Icon="{StaticResource CinemaMark}" Width="1450" Height="930" MinWidth="1040" MinHeight="690" Background="#090A0C" Foreground="#F5F5F6" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="{Binding TextSize}" WindowStartupLocation="CenterScreen">
<Window.InputBindings><KeyBinding Modifiers="Control" Key="R" Command="{Binding RefreshCommand}"/><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/></Window.InputBindings>
<Window.Resources>
  <!-- Poster card from the design: image with the title over a dark fade, meta line, rating chip and a round download button. -->
  <DataTemplate x:Key="PosterCard">
    <Border Width="{Binding DataContext.CardWidth,RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,16,18" CornerRadius="10" Background="#111216" BorderBrush="#24252B" BorderThickness="1">
      <StackPanel>
        <Button Command="{Binding DataContext.SelectCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="0" Margin="0" Background="Transparent" AutomationProperties.Name="{Binding DisplayTitle}" ToolTip="{Binding DisplayTitle}">
          <Grid Height="{Binding DataContext.CardWidth,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource PosterHeight}}">
            <Border Background="#1B1C22" CornerRadius="9,9,0,0" ClipToBounds="True"><Image Source="{Binding ImageSource}" Stretch="UniformToFill"/></Border>
            <Border CornerRadius="9,9,0,0" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.5"/><GradientStop Color="#F2000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
            <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Bottom" HorizontalAlignment="Center" TextAlignment="Center" Margin="10,0,10,10" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Button>
        <TextBlock Text="{Binding MetaLine}" Foreground="#A6A8B2" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,9,8,8"/>
        <TextBlock Text="{Binding ProgressText}" Foreground="#ED9DA9" FontSize="11" TextTrimming="CharacterEllipsis" Margin="10,0" FlowDirection="LeftToRight" HorizontalAlignment="Center" ToolTip="{Binding ProgressText}"/>
        <DockPanel Margin="10,2,10,10">
          <Button Content="⬇" DockPanel.Dock="Left" Style="{StaticResource RoundButton}" Width="32" Height="32" Command="{Binding DataContext.DownloadCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="تحميل واختيار الجودة"/>
          <Button Content="▶" DockPanel.Dock="Left" Style="{StaticResource RoundButton}" Width="32" Height="32" Margin="6,0" Command="{Binding DataContext.WatchCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="مشاهدة"/>
          <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Margin="0"><TextBlock Text="{Binding Rating,StringFormat=★ {0}}" FontSize="11" FlowDirection="LeftToRight"/></Border>
        </DockPanel>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="ContinueCard">
    <Border Width="260" Margin="0,0,16,8" CornerRadius="10" Background="#111216" BorderBrush="#24252B" BorderThickness="1">
      <Button Command="{Binding DataContext.WatchCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Movie}" Padding="0" Margin="0" Background="Transparent" ToolTip="متابعة المشاهدة">
        <StackPanel>
          <Grid Height="140"><Border CornerRadius="9,9,0,0" ClipToBounds="True" Background="#1B1C22"><Image Source="{Binding Movie.ImageSource}" Stretch="UniformToFill"/></Border>
            <TextBlock Text="▶" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E6FFFFFF"/></Grid>
          <ProgressBar Height="4" Value="{Binding Percent,Mode=OneWay}" Foreground="{StaticResource Accent}" Background="#303138" BorderThickness="0"/>
          <TextBlock Text="{Binding Movie.DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="10,8,10,2"/>
          <TextBlock Text="{Binding ProgressLabel}" Foreground="#9396A1" FontSize="11" Margin="10,0,10,10" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
        </StackPanel>
      </Button>
    </Border>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="Row"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
</Window.Resources>
<Grid x:Name="RootLayout">
<Grid.ColumnDefinitions><ColumnDefinition Width="262"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

<!-- Sidebar (right side in RTL) -->
<Border x:Name="Sidebar" Background="#0D0E11" BorderBrush="#25262C" BorderThickness="1,0,0,0" Padding="16,26"><DockPanel>
<StackPanel DockPanel.Dock="Top">
<TextBlock Text="سينمانا" FontSize="46" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,22"/>
<Border Background="#15161B" BorderBrush="#303138" BorderThickness="1" CornerRadius="10" Margin="0,0,0,26">
  <DockPanel><TextBlock Text="⌕" FontSize="20" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0" Foreground="#C9CBD3"/>
  <Grid><TextBlock Text="ابحث عن فيلم أو مسلسل …" Foreground="#6F727C" VerticalAlignment="Center" Margin="13,0" FontSize="13" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <TextBox x:Name="SearchBox" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="ابحث عن فيلم أو مسلسل" ToolTip="ابحث عن فيلم أو مسلسل • Ctrl+F" FontSize="13"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox></Grid></DockPanel>
</Border>
<Button Style="{StaticResource NavButton}" Tag="home" Command="{Binding NavigateCommand}" CommandParameter="home"><DockPanel><TextBlock Text="⌂" FontSize="22" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="الرئيسية" VerticalAlignment="Center"/></DockPanel></Button>
<Button Style="{StaticResource NavButton}" Tag="movies" Command="{Binding NavigateCommand}" CommandParameter="movies"><DockPanel><TextBlock Text="🎞" FontSize="19" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="أفلام" VerticalAlignment="Center"/></DockPanel></Button>
<Button Style="{StaticResource NavButton}" Tag="series" Command="{Binding NavigateCommand}" CommandParameter="series"><DockPanel><TextBlock Text="📺" FontSize="18" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="مسلسلات" VerticalAlignment="Center"/></DockPanel></Button>
<Button Style="{StaticResource NavButton}" Click="OpenDownloadsClick"><DockPanel><Grid DockPanel.Dock="Right" Margin="12,0,0,0"><TextBlock Text="⬇" FontSize="20"/>
  <Border x:Name="DownloadBadge" Background="{StaticResource Accent}" CornerRadius="9" MinWidth="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-12,-8,0,0" Visibility="{Binding HasPending,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding PendingCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border></Grid>
  <TextBlock Text="التنزيلات" VerticalAlignment="Center"/></DockPanel></Button>
<Border Height="1" Background="#28292F" Margin="8,20"/>
<Button Style="{StaticResource NavButton}" Tag="history" Command="{Binding NavigateCommand}" CommandParameter="history"><DockPanel><TextBlock Text="▷" FontSize="20" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="مشاهدة" VerticalAlignment="Center"/></DockPanel></Button>
<Button Style="{StaticResource NavButton}" Tag="favorites" Command="{Binding NavigateCommand}" CommandParameter="favorites"><DockPanel><TextBlock Text="♡" FontSize="20" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock VerticalAlignment="Center"><Run Text="المفضلة  "/><Run Text="{Binding FavoriteCount,Mode=OneWay}" Foreground="#8E9099"/></TextBlock></DockPanel></Button>
<Button Style="{StaticResource NavButton}" Tag="library" Command="{Binding NavigateCommand}" CommandParameter="library"><DockPanel><TextBlock Text="▤" FontSize="19" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="مكتبتي" VerticalAlignment="Center"/></DockPanel></Button>
</StackPanel>
<StackPanel DockPanel.Dock="Bottom">
  <DockPanel Margin="10,0,10,14">
    <Border Width="46" Height="46" CornerRadius="23" DockPanel.Dock="Right" Background="#2A2B31" BorderBrush="#45464D" BorderThickness="1"><TextBlock Text="{Binding UserInitial}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Text="{Binding DisplayName}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <Button Style="{StaticResource NavButton}" Command="{Binding SettingsCommand}"><DockPanel><TextBlock Text="⚙" FontSize="20" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="الإعدادات" VerticalAlignment="Center"/></DockPanel></Button>
</StackPanel><Border/>
</DockPanel></Border>

<Grid x:Name="LibraryPanel" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer x:Name="CatalogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>

<!-- Banner -->
<Grid Height="460" ClipToBounds="True" Background="#15161A" Visibility="{Binding HasHero,Converter={StaticResource BoolVisibility}}">
  <Image Source="{Binding Hero.ImageSource}" Stretch="UniformToFill" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
  <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="1,0" EndPoint="0,0"><GradientStop Color="#FF090A0C" Offset="0"/><GradientStop Color="#E6090A0C" Offset="0.32"/><GradientStop Color="#40090A0C" Offset="0.7"/><GradientStop Color="#10090A0C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00090A0C" Offset="0.6"/><GradientStop Color="#FF090A0C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <StackPanel Margin="70,40,60,40" HorizontalAlignment="Left" VerticalAlignment="Center" Width="{Binding HeroTextWidth,RelativeSource={RelativeSource AncestorType=Window}}">
    <TextBlock Text="{Binding Hero.DisplayTitle}" FontSize="58" FontWeight="Black" TextWrapping="Wrap" MaxHeight="150" TextTrimming="CharacterEllipsis" LineHeight="66"/>
    <TextBlock Text="{Binding Hero.Title}" Foreground="#C9CBD3" FontSize="20" Margin="0,6,0,14" TextTrimming="CharacterEllipsis"/>
    <WrapPanel Margin="0,0,0,18">
      <Border Style="{StaticResource Chip}" Margin="0,0,4,0"><TextBlock Text="{Binding Hero.Rating,StringFormat=★ {0}}" FlowDirection="LeftToRight" FontSize="13"/></Border>
      <Border Style="{StaticResource Chip}"><TextBlock Text="HD" FontSize="13"/></Border>
      <TextBlock Text="|" Foreground="#5D6069" Margin="8,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Hero.FirstGenre}" Foreground="#D5D7DE" VerticalAlignment="Center"/>
      <TextBlock Text="|" Foreground="#5D6069" Margin="8,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Hero.HoursLabel}" Foreground="#D5D7DE" VerticalAlignment="Center"/>
      <TextBlock Text="|" Foreground="#5D6069" Margin="8,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Hero.Year}" Foreground="#D5D7DE" VerticalAlignment="Center"/>
    </WrapPanel>
    <WrapPanel>
      <Button Background="{StaticResource Accent}" Command="{Binding WatchCommand}" CommandParameter="{Binding Hero}" Padding="44,14" FontSize="18" FontWeight="SemiBold" Margin="0,0,14,0"><StackPanel Orientation="Horizontal"><TextBlock Text="مشاهدة"/><TextBlock Text="  ▶" FlowDirection="LeftToRight"/></StackPanel></Button>
      <Button Style="{StaticResource GhostButton}" Command="{Binding DownloadCommand}" CommandParameter="{Binding Hero}" Padding="38,14" FontSize="18"><StackPanel Orientation="Horizontal"><TextBlock Text="تحميل"/><TextBlock Text="  ⬇"/></StackPanel></Button>
      <Button Content="♡" Command="{Binding FavoriteCommand}" ToolTip="{Binding FavoriteLabel}" Style="{StaticResource RoundButton}" Width="48" Height="48" Margin="12,0,0,0"/>
      <Button Content="التفاصيل والحلقات" Click="ToggleDetailsClick" Style="{StaticResource GhostButton}" Padding="16,14" FontSize="13" Margin="10,0,0,0"/>
    </WrapPanel>
    <TextBlock Text="{Binding Hero.Description}" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" LineHeight="26" Foreground="#C9CAD1" Margin="0,22,0,0" FontSize="15"/>
  </StackPanel>
  <Button Content="›" Style="{StaticResource RoundButton}" Width="44" Height="44" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Command="{Binding PreviousHeroCommand}" Visibility="{Binding IsHome,Converter={StaticResource BoolVisibility}}" ToolTip="السابق"/>
  <Button Content="‹" Style="{StaticResource RoundButton}" Width="44" Height="44" FontSize="26" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" Command="{Binding NextHeroCommand}" Visibility="{Binding IsHome,Converter={StaticResource BoolVisibility}}" ToolTip="التالي"/>
  <ItemsControl ItemsSource="{Binding HeroItems}" ItemsPanel="{StaticResource Row}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Visibility="{Binding IsHome,Converter={StaticResource BoolVisibility}}">
    <ItemsControl.ItemTemplate><DataTemplate>
      <Button Command="{Binding DataContext.HeroDotCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="0" Margin="4,0" Background="Transparent" Width="14" Height="14">
        <Ellipse Width="10" Height="10"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#80FFFFFF"/><Style.Triggers>
          <DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource IndexEquals}"><Binding/><Binding Path="DataContext.Hero" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></DataTrigger.Binding><Setter Property="Fill" Value="#E50932"/></DataTrigger>
        </Style.Triggers></Style></Ellipse.Style></Ellipse>
      </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
</Grid>

<!-- Details and episodes of the selected title -->
<Border x:Name="DetailsPanel" Visibility="Collapsed" Background="#121317" BorderBrush="#292A30" BorderThickness="1" CornerRadius="12" Margin="30,0,30,20" Padding="20">
<ScrollViewer x:Name="DetailsScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto"><StackPanel>
<DockPanel><Button Content="✕ إغلاق" DockPanel.Dock="Left" Click="CloseDetailsClick" Padding="12,6"/><TextBlock Text="{Binding Selected.DisplayTitle}" FontSize="20" FontWeight="SemiBold"/></DockPanel>
<TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" LineHeight="25" Margin="0,10,0,12"/>
<TextBlock Text="{Binding Selected.Language,StringFormat=اللغة: {0}}" Foreground="#A7AAB4"/>
<TextBlock Text="{Binding Selected.Director,StringFormat=الإخراج: {0}}" Foreground="#A7AAB4" Margin="0,5"/>
<TextBlock Text="{Binding Selected.Cast,StringFormat=التمثيل: {0}}" Foreground="#A7AAB4" TextWrapping="Wrap"/>
<TextBlock Text="{Binding Selected.DurationLabel}" Foreground="#A7AAB4" Margin="0,5"/>
<ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource Accent}" Visibility="{Binding DetailsBusy,Converter={StaticResource BoolVisibility}}"/>
<TextBlock Text="{Binding DetailsStatus}" Foreground="#E1C185" Margin="0,8"/>
<ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" AutomationProperties.Name="الموسم" HorizontalAlignment="Right">
  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=الموسم {0}}"/></DataTemplate></ComboBox.ItemTemplate>
  <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding Seasons.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
</ComboBox>
<ItemsControl ItemsSource="{Binding Episodes}"><ItemsControl.ItemTemplate><DataTemplate>
  <DockPanel><Button Content="⬇" DockPanel.Dock="Left" Command="{Binding DataContext.DownloadCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="تنزيل هذه الحلقة"/><Button Content="{Binding EpisodeLabel}" Command="{Binding DataContext.WatchCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Right"/></DockPanel>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></ScrollViewer></Border>

<StackPanel Margin="30,6,30,12">
<!-- Settings -->
<Border Background="#18191E" Padding="18" CornerRadius="12" Margin="0,0,0,18" Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}">
  <StackPanel>
    <TextBlock Text="الإعدادات" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="الاسم الظاهر" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding UserName,UpdateSourceTrigger=LostFocus}" Width="150" Padding="8,6"/>
      <CheckBox Content="حفظ الصور محليًا لتسريع التصفح" IsChecked="{Binding CacheImages}" Margin="22,8,4,8"/>
      <TextBlock Text="حجم البطاقات" VerticalAlignment="Center" Margin="22,0,8,0"/><Slider Width="100" Minimum="160" Maximum="240" Value="{Binding CardWidth}" VerticalAlignment="Center"/>
      <TextBlock Text="حجم الخط" VerticalAlignment="Center" Margin="22,0,8,0"/><Slider Width="80" Minimum="12" Maximum="18" Value="{Binding TextSize}" VerticalAlignment="Center"/>
    </WrapPanel>
    <WrapPanel VerticalAlignment="Center" Margin="0,10,0,0">
      <TextBlock Text="تنزيلات متزامنة" VerticalAlignment="Center"/><ComboBox SelectedIndex="{Binding ParallelIndex}" MinWidth="70"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/></ComboBox>
      <TextBlock Text="حد السرعة" VerticalAlignment="Center" Margin="18,0,0,0"/><ComboBox SelectedIndex="{Binding SpeedLimitIndex}" MinWidth="120"><ComboBoxItem Content="بلا حد"/><ComboBoxItem Content="512 KB/s"/><ComboBoxItem Content="1 MB/s"/><ComboBoxItem Content="2 MB/s"/><ComboBoxItem Content="5 MB/s"/><ComboBoxItem Content="10 MB/s"/></ComboBox>
      <CheckBox Content="متابعة التنزيلات تلقائيًا عند فتح التطبيق" IsChecked="{Binding AutoResumeDownloads}" Margin="18,8,4,8"/>
      <CheckBox Content="إشعار Windows عند اكتمال التنزيل" IsChecked="{Binding NotifyOnComplete}" Margin="18,8,4,8"/>
    </WrapPanel>
    <TextBlock Text="تُحفظ التفضيلات تلقائيًا." Foreground="#A2B0C7" Margin="0,8,0,0"/>
  </StackPanel>
</Border>

<!-- Home rows -->
<StackPanel Visibility="{Binding IsHome,Converter={StaticResource BoolVisibility}}">
  <StackPanel Visibility="{Binding HasContinueWatching,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16">
    <DockPanel Margin="0,0,0,12"><Button Content="عرض الكل  ‹" DockPanel.Dock="Left" Background="Transparent" Foreground="#A9ABB4" Command="{Binding NavigateCommand}" CommandParameter="history" Padding="6"/><TextBlock Text="تابع المشاهدة" FontSize="22" FontWeight="SemiBold"/></DockPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RowWheel"><ItemsControl ItemsSource="{Binding ContinueWatching}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource ContinueCard}"/></ScrollViewer>
  </StackPanel>
  <DockPanel Margin="0,0,0,12"><Button Content="عرض الكل  ‹" DockPanel.Dock="Left" Background="Transparent" Foreground="#A9ABB4" Command="{Binding NavigateCommand}" CommandParameter="movies" Padding="6"/><TextBlock Text="أفلام مميزة" FontSize="22" FontWeight="SemiBold"/></DockPanel>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RowWheel"><ItemsControl ItemsSource="{Binding FeaturedMovies}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource PosterCard}"/></ScrollViewer>
  <StackPanel Visibility="{Binding HasSeriesRow,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
    <DockPanel Margin="0,0,0,12"><Button Content="عرض الكل  ‹" DockPanel.Dock="Left" Background="Transparent" Foreground="#A9ABB4" Command="{Binding NavigateCommand}" CommandParameter="series" Padding="6"/><TextBlock Text="أحدث المسلسلات" FontSize="22" FontWeight="SemiBold"/></DockPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RowWheel"><ItemsControl ItemsSource="{Binding LatestSeries}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource PosterCard}"/></ScrollViewer>
  </StackPanel>
</StackPanel>

<!-- Section grid -->
<Grid Margin="0,14,0,16"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold"/>
  <WrapPanel Grid.Row="1" Margin="0,12,0,0">
    <TextBlock Text="تصفية الصفحة:" VerticalAlignment="Center" Foreground="#8E9EB9" Margin="0,0,8,0"/>
    <ComboBox ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" AutomationProperties.Name="التصنيف"/>
    <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" AutomationProperties.Name="السنة"/>
    <ComboBox SelectedIndex="{Binding RatingIndex}" AutomationProperties.Name="الحد الأدنى للتقييم"><ComboBoxItem Content="كل التقييمات"/><ComboBoxItem Content="6 فأعلى"/><ComboBoxItem Content="7 فأعلى"/><ComboBoxItem Content="8 فأعلى"/></ComboBox>
    <ComboBox SelectedIndex="{Binding SortIndex}" AutomationProperties.Name="الترتيب"><ComboBoxItem Content="ترتيب الخدمة"/><ComboBoxItem Content="الأعلى تقييمًا"/><ComboBoxItem Content="الأحدث سنةً"/><ComboBoxItem Content="الاسم"/></ComboBox>
    <Button Content="مسح الفلاتر" Command="{Binding ResetFiltersCommand}" Background="Transparent" Foreground="#A9B6CB"/>
  </WrapPanel>
</Grid>
<Grid><ItemsControl ItemsSource="{Binding Movies}" x:Name="Catalog" ItemTemplate="{StaticResource PosterCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
<Border Background="#EC090A0C" MinHeight="200" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"><StackPanel Width="220" HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource Accent}"/><TextBlock Text="نجهّز مكتبتك…" HorizontalAlignment="Center" Margin="0,18"/></StackPanel></Border>
<StackPanel MinHeight="180" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}"><TextBlock Text="لا توجد عناوين لعرضها" FontSize="22"/><TextBlock Text="جرّب بحثًا آخر أو امسح الفلاتر." Foreground="#A6A8B2" Margin="0,12"/><Button Content="إعادة المحاولة" Command="{Binding RefreshCommand}"/></StackPanel>
</Grid></StackPanel></StackPanel></ScrollViewer>

<!-- Download bar from the design -->
<Border x:Name="DownloadDock" Grid.Row="1" Margin="24,6" Padding="14,12" Background="#121317" BorderBrush="#28292F" BorderThickness="1" CornerRadius="12" Visibility="{Binding HasDockItem,Converter={StaticResource BoolVisibility}}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Border Width="96" Height="64" CornerRadius="7" ClipToBounds="True" Background="#1B1C22"><Image Source="{Binding DockItem.Poster}" Stretch="UniformToFill"/></Border>
  <Button Grid.Column="1" Background="Transparent" Padding="14,0" Click="OpenDownloadsClick" ToolTip="فتح قائمة التنزيلات" MaxWidth="260" HorizontalContentAlignment="Right">
    <StackPanel><TextBlock Text="{Binding DockItem.Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DockItem.StatusLabel}" Foreground="#9396A1" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding Summary}" Foreground="#6F727C" FontSize="11" Margin="0,3,0,0"/></StackPanel>
  </Button>
  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
    <ProgressBar Value="{Binding DockItem.Percent,Mode=OneWay,FallbackValue=0}" IsIndeterminate="{Binding DockItem.Indeterminate,Mode=OneWay,FallbackValue=False}" Height="5" Foreground="{StaticResource Accent}" Background="#303138" BorderThickness="0" FlowDirection="RightToLeft"/>
    <DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding DockItem.SizeLabel}" Foreground="#A6A8B2" FontSize="12" FlowDirection="LeftToRight" DockPanel.Dock="Left"/><TextBlock Text="{Binding DockItem.RateLine}" Foreground="#A6A8B2" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
    <TextBlock Text="{Binding TotalsLabel}" Foreground="#6F727C" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right"/>
  </StackPanel>
  <Border Grid.Column="3" Style="{StaticResource Chip}" Padding="12,6" Margin="8,0"><TextBlock Text="{Binding DockItem.QualityChip}" FontSize="14" FlowDirection="LeftToRight"/></Border>
  <StackPanel Grid.Column="4" Orientation="Horizontal">
    <Button Style="{StaticResource RoundButton}" Command="{Binding ToggleCommand}" CommandParameter="{Binding DockItem}" ToolTip="إيقاف مؤقت / متابعة" Margin="6,0">
      <Button.Content><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="▶"/><Style.Triggers><DataTrigger Binding="{Binding DockItem.CanPause}" Value="True"><Setter Property="Text" Value="❚❚"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button.Content>
    </Button>
    <Button Content="✕" Style="{StaticResource RoundButton}" Command="{Binding CancelCommand}" CommandParameter="{Binding DockItem}" ToolTip="إلغاء" IsEnabled="{Binding DockItem.CanCancel,FallbackValue=False}"/>
  </StackPanel>
</Grid></Border>

<DockPanel Grid.Row="2" Margin="24,4,24,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="السابق" Command="{Binding PreviousCommand}" Padding="12,7"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="10,0" Foreground="#9598A2"/><Button Content="التالي" Command="{Binding NextCommand}" Padding="12,7"/></StackPanel><Button Content="↻" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" ToolTip="تحديث" Padding="12,7"/><TextBlock Text="{Binding Status}" Foreground="#82858F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" Margin="5,0"/></DockPanel>
</Grid><Border x:Name="PlayerHost" Grid.ColumnSpan="2" Panel.ZIndex="10" Background="#08090B" Visibility="Collapsed"/>
</Grid></Window>
