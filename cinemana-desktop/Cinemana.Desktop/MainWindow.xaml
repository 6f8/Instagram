<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Cinemana.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="سينمانا" Icon="{StaticResource CinemaMark}" Width="1450" Height="930" MinWidth="1040" MinHeight="690" Background="{StaticResource Ground}" Foreground="{StaticResource Ink}" FlowDirection="RightToLeft" FontFamily="{StaticResource BodyFont}" FontSize="{Binding TextSize}" WindowStartupLocation="CenterScreen">
<Window.InputBindings><KeyBinding Modifiers="Control" Key="R" Command="{Binding RefreshCommand}"/><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/></Window.InputBindings>
<Window.Resources>
  <!-- Design 5 poster card: square poster, title and meta under it, amber rating, text actions. -->
  <DataTemplate x:Key="PosterCard">
    <StackPanel Width="{Binding DataContext.CardWidth,RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,24,26" Tag="{Binding}" ContextMenuOpening="CardMenuOpening">
      <StackPanel.ContextMenu><ContextMenu/></StackPanel.ContextMenu>
      <Button Command="{Binding DataContext.SelectCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="0" Margin="0" Background="Transparent" AutomationProperties.Name="{Binding DisplayTitle}" AutomationProperties.HelpText="{Binding MetaLine}" ToolTipService.InitialShowDelay="600">
        <Button.ToolTip><ToolTip Background="{StaticResource Panel}" BorderBrush="{StaticResource Numeral}" Foreground="{StaticResource Ink}" MaxWidth="340" Padding="12" FlowDirection="RightToLeft">
          <StackPanel><TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
            <TextBlock Foreground="{StaticResource Accent}" Margin="0,6"><Run Text="{Binding MetaLine,Mode=OneWay}"/><Run Text="  ★ "/><Run Text="{Binding Rating,Mode=OneWay}"/></TextBlock>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="110" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Body}"/></StackPanel>
        </ToolTip></Button.ToolTip>
        <Grid Height="{Binding DataContext.CardWidth,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource PosterHeight}}" Background="{StaticResource Surface}" ClipToBounds="True">
          <Image Source="{Binding ImageSource,Converter={StaticResource Poster},ConverterParameter=360}" Stretch="UniformToFill"/>
          <Border Background="#E60E1222" VerticalAlignment="Top" HorizontalAlignment="Right" Padding="8,3"><TextBlock Text="{Binding Rating,StringFormat=★ {0}}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" FlowDirection="LeftToRight"/></Border>
        </Grid>
      </Button>
      <Border Height="3" Background="{StaticResource Line}" Margin="0,12,0,10"/>
      <TextBlock Text="{Binding DisplayTitle}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding MetaLine}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Right" ToolTip="{Binding ProgressText}"/>
      <StackPanel Orientation="Horizontal" Margin="-10,6,0,0">
        <Button Content="مشاهدة" Style="{StaticResource LinkButton}" Command="{Binding DataContext.WatchCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
        <Button Content="تحميل" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Command="{Binding DataContext.DownloadCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsRemote,Converter={StaticResource BoolVisibility}}"/>
        <Button Content="حذف" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Click="DeleteLocalClick" Tag="{Binding}" Visibility="{Binding IsLocal,Converter={StaticResource BoolVisibility}}"/>
      </StackPanel>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="ContinueCard">
    <Button AutomationProperties.Name="متابعة المشاهدة" Width="300" Margin="0,0,24,8" Padding="0" Background="Transparent" Command="{Binding DataContext.WatchCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Movie}" ToolTip="متابعة المشاهدة" HorizontalContentAlignment="Stretch">
      <StackPanel>
        <Grid Height="160" Background="{StaticResource Surface}" ClipToBounds="True"><Image Source="{Binding Movie.ImageSource,Converter={StaticResource Poster},ConverterParameter=480}" Stretch="UniformToFill"/></Grid>
        <ProgressBar Height="3" Value="{Binding Percent,Mode=OneWay}" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
        <TextBlock Text="{Binding Movie.DisplayTitle}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,10,0,2"/>
        <TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource Muted}" FontSize="12" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
      </StackPanel>
    </Button>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="Row"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="FontSize" Value="30"/></Style>
</Window.Resources>
<Grid x:Name="RootLayout">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

<!-- Header bar -->
<Border x:Name="Sidebar" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="56,0" Height="84">
<DockPanel>
  <TextBlock Text="سينمانا" DockPanel.Dock="Right" FontFamily="{StaticResource Display}" FontSize="30" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,0,0"/>
  <Button AutomationProperties.Name="رجوع (Esc أو Alt+←)" DockPanel.Dock="Right" Style="{StaticResource NavButton}" Command="{Binding BackCommand}" ToolTip="رجوع (Esc أو Alt+←)" Margin="22,0,0,0" Visibility="{Binding CanGoBack,Converter={StaticResource BoolVisibility}}"><TextBlock Text="→ رجوع"/></Button>
  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
    <Button AutomationProperties.Name="الإعدادات" Style="{StaticResource NavButton}" Command="{Binding SettingsCommand}" ToolTip="الإعدادات" Margin="10,0"><TextBlock Text="⚙" FontSize="18"/></Button>
    <Border Width="40" Height="40" Background="{StaticResource Surface}" BorderBrush="{StaticResource Numeral}" BorderThickness="1" ToolTip="{Binding DisplayName}"><TextBlock Text="{Binding UserInitial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <Border BorderBrush="{StaticResource Faint}" BorderThickness="0,0,0,1" Width="250" Height="40" Margin="20,0,24,0">
      <DockPanel><TextBlock Text="⌕" FontSize="18" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,0,0"/>
      <Grid><TextBlock Text="ابحث في المكتبة" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBox x:Name="SearchBox" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="ابحث في المكتبة" ToolTip="/ أو Ctrl+F" GotKeyboardFocus="SearchFocused"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox></Grid></DockPanel>
    </Border>
    <Popup IsOpen="{Binding SuggestionsOpen,Mode=TwoWay}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" FlowDirection="RightToLeft">
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Numeral}" BorderThickness="1" Width="360" Padding="6">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Suggestions}"><ItemsControl.ItemTemplate><DataTemplate>
            <Button Background="Transparent" Padding="6" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.PickSuggestionCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
              <DockPanel><Grid Width="40" Height="56" DockPanel.Dock="Right" Background="{StaticResource Surface}"><Image Source="{Binding ImageSource,Converter={StaticResource Poster},ConverterParameter=80}" Stretch="UniformToFill"/></Grid>
                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource Muted}" FontSize="12"><Run Text="{Binding TypeLabel,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding MetaLine,Mode=OneWay}"/></TextBlock></StackPanel></DockPanel>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="عمليات بحث سابقة" Foreground="{StaticResource Muted}" FontSize="12" Margin="6,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Suggestions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <ItemsControl ItemsSource="{Binding RecentSearches}"><ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Suggestions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Style="{StaticResource LinkButton}" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" Command="{Binding DataContext.PickSuggestionCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="Enter لعرض كل النتائج" Foreground="{StaticResource Faint}" FontSize="11" Margin="6,6,6,2"/>
        </StackPanel>
      </Border>
    </Popup>
  </StackPanel>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="40,0,0,0">
    <Button Content="الرئيسية" Style="{StaticResource NavButton}" Tag="home" Command="{Binding NavigateCommand}" CommandParameter="home"/>
    <Button Content="أفلام" Style="{StaticResource NavButton}" Tag="movies" Command="{Binding NavigateCommand}" CommandParameter="movies"/>
    <Button Content="مسلسلات" Style="{StaticResource NavButton}" Tag="series" Command="{Binding NavigateCommand}" CommandParameter="series"/>
    <Button Content="تصنيفات" Style="{StaticResource NavButton}" Tag="genres" Command="{Binding NavigateCommand}" CommandParameter="genres"/>
    <Button Style="{StaticResource NavButton}" Click="OpenDownloadsClick"><StackPanel Orientation="Horizontal"><TextBlock Text="التنزيلات"/>
      <Border x:Name="DownloadBadge" Background="{StaticResource Accent}" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPending,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding PendingCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OnAccent}"/></Border></StackPanel></Button>
    <Button Content="مشاهدة" Style="{StaticResource NavButton}" Tag="history" Command="{Binding NavigateCommand}" CommandParameter="history"/>
    <Button Style="{StaticResource NavButton}" Tag="favorites" Command="{Binding NavigateCommand}" CommandParameter="favorites"><TextBlock><Run Text="المفضلة "/><Run Text="{Binding FavoriteCount,Mode=OneWay}" Foreground="{StaticResource Faint}"/></TextBlock></Button>
    <Button Content="مكتبتي" Style="{StaticResource NavButton}" Tag="library" Command="{Binding NavigateCommand}" CommandParameter="library"/>
  </StackPanel>
</DockPanel></Border>

<Grid x:Name="LibraryPanel" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer x:Name="CatalogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="56,0">

<!-- Notices: service problems and available updates -->
<Border Margin="0,18,0,0" Padding="16,10" Background="#2A1E0A" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,3,0" Visibility="{Binding HasServiceNotice,Converter={StaticResource BoolVisibility}}">
  <DockPanel><Button Content="فتح مكتبتي" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="library"/><TextBlock Text="{Binding ServiceNotice}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
</Border>
<Border Margin="0,10,0,0" Padding="16,10" Background="{StaticResource Panel}" BorderBrush="{StaticResource Numeral}" BorderThickness="0,0,3,0" Visibility="{Binding HasUpdate,Converter={StaticResource BoolVisibility}}">
  <DockPanel><Button Content="صفحة الإصدار" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Click="OpenUpdateClick"/><Button Content="تحديث الآن" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Click="InstallUpdateClick" Visibility="{Binding CanInstallUpdate,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding UpdateNotice}" VerticalAlignment="Center"/></DockPanel>
</Border>
<!-- Editorial banner: text on the right, poster panel on the left -->
<StackPanel Visibility="{Binding DetailsOpen,Converter={StaticResource NotVisibility}}">
<Grid x:Name="Banner" Height="470" Margin="0,36,0,0" Visibility="{Binding HasHero,Converter={StaticResource BoolVisibility}}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center">
    <TextBlock Foreground="{StaticResource Accent}" FontSize="15" Margin="0,0,0,16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="اختيار المحرر"/><Style.Triggers><DataTrigger Binding="{Binding IsHome}" Value="False"><Setter Property="Text" Value="{Binding Hero.TypeLabel}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBlock Text="{Binding Hero.DisplayTitle}" FontFamily="{StaticResource Display}" FontSize="92" LineHeight="100" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxHeight="210" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding Hero.Description}" FontSize="18" LineHeight="32" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Body}" Margin="0,18,0,0" MaxWidth="620" HorizontalAlignment="Left"/>
    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
      <Button Content="شاهد الآن" Style="{StaticResource PrimaryButton}" Command="{Binding WatchCommand}" CommandParameter="{Binding Hero}" Padding="40,16" FontSize="18" Margin="0,0,14,0"/>
      <Button Content="تحميل" Style="{StaticResource GhostButton}" Command="{Binding DownloadCommand}" CommandParameter="{Binding Hero}" Padding="30,16" FontSize="18" Margin="0,0,14,0"/>
      <Button Content="♡" Style="{StaticResource GhostButton}" Command="{Binding FavoriteCommand}" ToolTip="{Binding FavoriteLabel}" Padding="18,16" FontSize="18" Margin="0,0,14,0"/>
      <Button Content="الحلقات والتفاصيل" Style="{StaticResource LinkButton}" Click="ToggleDetailsClick" VerticalAlignment="Center"/>
      <Button AutomationProperties.Name="اختيار عشوائي من العناوين التي لم تشاهدها" Content="🎲 ماذا أشاهد الليلة؟" Style="{StaticResource LinkButton}" Click="RandomClick" VerticalAlignment="Center" ToolTip="اختيار عشوائي من العناوين التي لم تشاهدها"/>
    </StackPanel>
    <TextBlock Foreground="{StaticResource Muted}" FontSize="15" Margin="0,18,0,0">
      <Run Text="{Binding Hero.FirstGenre,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Hero.Year,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Hero.HoursLabel,Mode=OneWay}"/><Run Text=" · ★ "/><Run Text="{Binding Hero.Rating,Mode=OneWay}"/>
    </TextBlock>
  </StackPanel>
  <Grid Grid.Column="2" Background="{StaticResource Surface}" ClipToBounds="True">
    <Image Source="{Binding Hero.ImageSource,Converter={StaticResource Poster},ConverterParameter=900}" Stretch="UniformToFill"/>
    <Border VerticalAlignment="Bottom" Background="#D90E1222" Padding="22,16" Visibility="{Binding IsHome,Converter={StaticResource BoolVisibility}}">
      <DockPanel>
        <TextBlock Text="{Binding HeroPositionLabel}" DockPanel.Dock="Right" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button AutomationProperties.Name="التالي" Content="‹" Style="{StaticResource LinkButton}" FontSize="24" Command="{Binding NextHeroCommand}" ToolTip="التالي"/></StackPanel>
        <Button Content="{Binding NextHeroLabel}" Style="{StaticResource LinkButton}" Foreground="{StaticResource Ink}" Command="{Binding NextHeroCommand}" HorizontalAlignment="Left"/>
      </DockPanel>
    </Border>
  </Grid>
</Grid>

</StackPanel>
<!-- Title page: details and big season tabs with numbered episodes -->
<Border x:Name="DetailsPanel" Visibility="{Binding DetailsOpen,Converter={StaticResource BoolVisibility}}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,26,0,0">
<StackPanel>
<!-- Backdrop: the title's image blurred behind its name, as a page header -->
<Grid Height="240" ClipToBounds="True" Margin="-56,-26,-56,26">
  <Image Source="{Binding Selected.ImageSource,Converter={StaticResource Poster},ConverterParameter=600}" Stretch="UniformToFill" Margin="-40"><Image.Effect><BlurEffect Radius="40"/></Image.Effect></Image>
  <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#550E1222" Offset="0"/><GradientStop Color="#FF0E1222" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <DockPanel VerticalAlignment="Bottom" Margin="56,0,56,20">
    <Grid Width="110" Height="160" DockPanel.Dock="Right" Background="{StaticResource Surface}" Margin="0,0,0,-60"><Image Source="{Binding Selected.ImageSource,Converter={StaticResource Poster},ConverterParameter=220}" Stretch="UniformToFill"/></Grid>
    <Button Content="→ رجوع" Style="{StaticResource LinkButton}" Foreground="#F5F1E6" Command="{Binding BackCommand}" DockPanel.Dock="Left" VerticalAlignment="Top"/>
    <StackPanel Margin="0,0,20,0" VerticalAlignment="Bottom"><TextBlock Text="{Binding Selected.TypeLabel}" Foreground="{StaticResource Accent}"/><TextBlock Foreground="#E6F5F1E6" FontSize="15" Margin="0,6,0,0"><Run Text="{Binding Selected.MetaLine,Mode=OneWay}"/><Run Text="  ★ "/><Run Text="{Binding Selected.Rating,Mode=OneWay}"/></TextBlock></StackPanel>
  </DockPanel>
</Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
  <StackPanel>
    <TextBlock Text="{Binding Selected.DisplayTitle}" FontFamily="{StaticResource Display}" FontSize="40" TextWrapping="Wrap"/>
    <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="{Binding Selected.HasSubtitles,Converter={StaticResource BoolVisibility},FallbackValue=Collapsed}"><TextBlock Text="مترجم" Foreground="{StaticResource Accent}" FontSize="12"/></Border>
    <TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" LineHeight="28" FontSize="15" Foreground="{StaticResource Body}" Margin="0,14"/>
    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="الإخراج" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Selected.Director}" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="1" Text="التمثيل" Foreground="{StaticResource Muted}" Margin="0,6"/><ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Selected.CastNames}" Margin="-10,0,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button AutomationProperties.Name="ابحث عن أعماله" Content="{Binding}" Style="{StaticResource LinkButton}" Foreground="{StaticResource Ink}" Click="CastClick" Tag="{Binding}" ToolTip="ابحث عن أعماله"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Grid.Row="2" Text="اللغة" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Language}"/>
      <TextBlock Grid.Row="3" Text="المدة" Foreground="{StaticResource Muted}" Margin="0,6"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.DurationLabel}" Margin="0,6"/>
    </Grid>
    <DockPanel Margin="0,10,0,0"><TextBlock Text="تقييمك" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Width="90" DockPanel.Dock="Right"/>
      <ComboBox SelectedIndex="{Binding NoteStars}" MinWidth="120" HorizontalAlignment="Right" AutomationProperties.Name="تقييمك"><ComboBoxItem Content="بلا تقييم"/><ComboBoxItem Content="★"/><ComboBoxItem Content="★★"/><ComboBoxItem Content="★★★"/><ComboBoxItem Content="★★★★"/><ComboBoxItem Content="★★★★★"/></ComboBox></DockPanel>
    <TextBox Text="{Binding NoteText,UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,8,0,0" AutomationProperties.Name="ملاحظتك" ToolTip="ملاحظة خاصة بك عن هذا العنوان"/>
    <ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource Accent}" Visibility="{Binding DetailsBusy,Converter={StaticResource BoolVisibility}}" Margin="0,8"/>
    <TextBlock Text="{Binding DetailsStatus}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,8"/>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="{Binding ContinueLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding ContinueCommand}" Padding="28,14" Margin="0,0,12,0"/>
      <Button Content="تحميل" Style="{StaticResource GhostButton}" Command="{Binding DownloadCommand}" Padding="24,14" Margin="0,0,12,0"/>
      <Button AutomationProperties.Name="أضف إلى «سأشاهده لاحقًا» أو قائمة جديدة" Content="+ قائمة" Style="{StaticResource LinkButton}" Click="AddToListClick" ToolTip="أضف إلى «سأشاهده لاحقًا» أو قائمة جديدة"/>
      <Button AutomationProperties.Name="تنزيل الحلقات الجديدة تلقائيًا عند صدورها" Content="{Binding FollowLabel}" Style="{StaticResource LinkButton}" Command="{Binding FollowCommand}" ToolTip="تنزيل الحلقات الجديدة تلقائيًا عند صدورها"/>
      <Button AutomationProperties.Name="تنزيل حلقات المسلسل التي لم تكملها" Content="حمّل غير المُشاهَد" Style="{StaticResource LinkButton}" Command="{Binding DownloadUnwatchedCommand}" ToolTip="تنزيل حلقات المسلسل التي لم تكملها"/>
      <Button Content="إغلاق" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Command="{Binding BackCommand}"/>
    </StackPanel>
  </StackPanel>
  <StackPanel Grid.Column="2">
    <ListBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" ItemContainerStyle="{StaticResource SeasonTab}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="المواسم" Margin="0,0,0,16" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=الموسم {0}}"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <ItemsControl x:Name="DetailsScroll" ItemsSource="{Binding Episodes}" MaxHeight="440" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
      <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14">
          <DockPanel>
            <TextBlock Text="{Binding Episode,StringFormat={}{0:00}}" FontFamily="{StaticResource Display}" FontSize="30" Foreground="{StaticResource Numeral}" Width="64" DockPanel.Dock="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" TextAlignment="Right"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <Button Content="مشاهدة" Style="{StaticResource LinkButton}" Command="{Binding DataContext.WatchCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
              <Button Content="تحميل" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Command="{Binding DataContext.DownloadCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
              <Button AutomationProperties.Name="تعليم كمُشاهَدة / غير مُشاهَدة" Content="✓" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" ToolTip="تعليم كمُشاهَدة / غير مُشاهَدة" Command="{Binding DataContext.MarkWatchedCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding EpisodeLabel}" FontWeight="Bold" FontSize="17"/><TextBlock Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0"><Run Text="{Binding DurationLabel,Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding ProgressText,Mode=OneWay}" Foreground="{StaticResource Accent}"/></TextBlock></StackPanel>
          </DockPanel>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
</Grid></StackPanel></Border>

<!-- Settings -->
<Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="0,22" Margin="0,30,0,0" Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}">
  <StackPanel>
    <TextBlock Text="الإعدادات" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
    <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="الاسم الظاهر" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding UserName,UpdateSourceTrigger=LostFocus}" Width="160" Padding="8,6"/>
      <CheckBox Content="حفظ الصور محليًا" IsChecked="{Binding CacheImages}" Margin="22,8,4,8"/>
      <TextBlock Text="حجم البطاقات" VerticalAlignment="Center" Margin="22,0,8,0"/><Slider Width="100" Minimum="160" Maximum="240" Value="{Binding CardWidth}" VerticalAlignment="Center"/>
      <TextBlock Text="حجم الخط" VerticalAlignment="Center" Margin="22,0,8,0"/><Slider Width="80" Minimum="12" Maximum="18" Value="{Binding TextSize}" VerticalAlignment="Center"/>
    </WrapPanel>
    <WrapPanel VerticalAlignment="Center" Margin="0,12,0,0">
      <TextBlock Text="تنزيلات متزامنة" VerticalAlignment="Center"/><ComboBox SelectedIndex="{Binding ParallelIndex}" MinWidth="70"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/></ComboBox>
      <TextBlock Text="حد السرعة" VerticalAlignment="Center" Margin="18,0,0,0"/><ComboBox SelectedIndex="{Binding SpeedLimitIndex}" MinWidth="120"><ComboBoxItem Content="بلا حد"/><ComboBoxItem Content="512 KB/s"/><ComboBoxItem Content="1 MB/s"/><ComboBoxItem Content="2 MB/s"/><ComboBoxItem Content="5 MB/s"/><ComboBoxItem Content="10 MB/s"/></ComboBox>
      <CheckBox Content="متابعة التنزيلات تلقائيًا عند الفتح" IsChecked="{Binding AutoResumeDownloads}" Margin="18,8,4,8"/>
      <CheckBox Content="إشعار Windows عند الاكتمال" IsChecked="{Binding NotifyOnComplete}" Margin="18,8,4,8"/>
    </WrapPanel>
    <WrapPanel VerticalAlignment="Center" Margin="0,10,0,0">
      <CheckBox Content="جدولة التنزيل من" IsChecked="{Binding ScheduleEnabled}" Margin="0,8,4,8"/><ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding ScheduleStart}" MinWidth="60"/><TextBlock Text="إلى" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding ScheduleEnd}" MinWidth="60"/>
      <TextBlock Text="حد السرعة ليلًا (12–7 ص)" VerticalAlignment="Center" Margin="18,0,0,0"/><ComboBox SelectedIndex="{Binding NightLimitIndex}" MinWidth="120"><ComboBoxItem Content="مثل النهار"/><ComboBoxItem Content="بلا حد"/><ComboBoxItem Content="512 KB/s"/><ComboBoxItem Content="1 MB/s"/><ComboBoxItem Content="2 MB/s"/><ComboBoxItem Content="5 MB/s"/><ComboBoxItem Content="10 MB/s"/></ComboBox>
      <CheckBox Content="إيقاف التنزيل على الشبكات محدودة الباقة" IsChecked="{Binding PauseOnMetered}" Margin="18,8,4,8"/>
      <TextBlock Text="بعد انتهاء القائمة" VerticalAlignment="Center" Margin="18,0,0,0"/><ComboBox SelectedIndex="{Binding AfterQueue}" MinWidth="130"><ComboBoxItem Content="لا شيء"/><ComboBoxItem Content="إسبات الجهاز"/><ComboBoxItem Content="إطفاء الجهاز"/></ComboBox>
      <CheckBox Content="تنزيل الحلقات الجديدة للمسلسلات المتابَعة" IsChecked="{Binding AutoDownloadFollowed}" Margin="18,8,4,8"/>
      <TextBlock Text="حذف المُشاهَد بعد (أيام، 0 = أبدًا)" VerticalAlignment="Center" Margin="18,0,0,0"/><ComboBox ItemsSource="{Binding DeleteDayChoices}" SelectedItem="{Binding AutoDeleteDays}" MinWidth="60"/>
    </WrapPanel>
    <TextBlock Text="المظهر" FontWeight="Bold" Margin="0,16,0,4"/>
    <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="الوضع" VerticalAlignment="Center"/><ComboBox SelectedIndex="{Binding ThemeMode}" MinWidth="120" AutomationProperties.Name="الوضع"><ComboBoxItem Content="داكن"/><ComboBoxItem Content="فاتح"/><ComboBoxItem Content="حسب Windows"/></ComboBox>
      <TextBlock Text="اللون الأساسي" VerticalAlignment="Center" Margin="18,0,0,0"/><ComboBox ItemsSource="{Binding AccentChoices}" SelectedValue="{Binding AccentColor}" SelectedValuePath="Hex" DisplayMemberPath="Name" MinWidth="110" AutomationProperties.Name="اللون الأساسي"/>
      <CheckBox Content="تباين عالٍ" IsChecked="{Binding HighContrast}" Margin="18,8,4,8"/>
      <TextBlock Text="تكبير الواجهة" VerticalAlignment="Center" Margin="18,0,8,0"/><Slider Width="110" Minimum="0.8" Maximum="1.6" Value="{Binding UiScale}" VerticalAlignment="Center" AutomationProperties.Name="تكبير الواجهة" ToolTip="أو Ctrl + عجلة الماوس"/>
      <CheckBox Content="وضع التلفاز (عناصر كبيرة، ملء الشاشة)" IsChecked="{Binding TvMode}" Margin="18,8,4,8"/>
      <CheckBox Content="حجم البطاقات تلقائيًا حسب النافذة" IsChecked="{Binding AutoCardWidth}" Margin="18,8,4,8"/>
      <Button Content="تطبيق الآن (إعادة تشغيل)" Style="{StaticResource LinkButton}" Click="RestartClick" Visibility="{Binding NeedsRestart,Converter={StaticResource BoolVisibility}}"/>
    </WrapPanel>
    <WrapPanel VerticalAlignment="Center" Margin="0,6,0,0">
      <CheckBox Content="تشغيل سينمانا مع Windows" IsChecked="{Binding StartWithWindows}" Margin="0,8,4,8"/>
      <CheckBox Content="يبدأ مصغّرًا بجانب الساعة" IsChecked="{Binding StartMinimized}" Margin="18,8,4,8"/>
      <Button Content="جولة تعريفية" Style="{StaticResource LinkButton}" Click="TourClick"/>
    </WrapPanel>
    <TextBlock Text="أدوات" FontWeight="Bold" Margin="0,16,0,4"/>
    <WrapPanel Margin="-10,0,0,0">
      <Button AutomationProperties.Name="ينسخ الإصدار وآخر سطور السجل لإرسالها" Content="نسخ تقرير المشكلة" Style="{StaticResource LinkButton}" Click="CopyReportClick" ToolTip="ينسخ الإصدار وآخر سطور السجل لإرسالها"/>
      <Button Content="فتح مجلد البيانات" Style="{StaticResource LinkButton}" Click="OpenDataClick"/>
      <Button AutomationProperties.Name="يضيف إلى مكتبتي الملفات الموجودة في المجلد" Content="إعادة فحص مجلد التنزيل" Style="{StaticResource LinkButton}" Click="RescanClick" ToolTip="يضيف إلى مكتبتي الملفات الموجودة في المجلد"/>
      <Button Content="حذف الملفات الجزئية القديمة" Style="{StaticResource LinkButton}" Click="CleanupClick"/>
      <Button x:Name="ClearCacheButton" Content="مسح ذاكرة الصور" Style="{StaticResource LinkButton}" Click="ClearCacheClick"/>
      <Button Content="الاختصارات (?)" Style="{StaticResource LinkButton}" Click="ShortcutsClick"/>
      <Button Content="إظهار العناوين المخفية" Style="{StaticResource LinkButton}" Click="ShowHiddenClick"/>
      <Button Content="التحقق من التحديثات" Style="{StaticResource LinkButton}" Click="CheckUpdatesClick"/>
    </WrapPanel>
    <TextBlock Text="النسخ الاحتياطي والمزامنة" FontWeight="Bold" Margin="0,16,0,4"/>
    <WrapPanel Margin="-10,0,0,0">
      <Button Content="نسخة احتياطية…" Style="{StaticResource LinkButton}" Click="BackupClick" ToolTip="المفضلة والسجل والقوائم والملاحظات والإعدادات في ملف واحد"/>
      <Button Content="استعادة نسخة…" Style="{StaticResource LinkButton}" Click="RestoreClick"/>
      <Button Content="مجلد المزامنة…" Style="{StaticResource LinkButton}" Click="ChooseSyncClick" ToolTip="مثل مجلد OneDrive: يتشارك جهازان المفضلة والسجل والقوائم"/>
      <Button Content="مزامنة الآن" Style="{StaticResource LinkButton}" Click="SyncNowClick"/>
      <TextBlock Text="{Binding SyncLabel}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0"/>
    </WrapPanel>
    <TextBlock Text="حول" FontWeight="Bold" Margin="0,16,0,4"/>
    <TextBlock Text="{Binding AboutText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
    <WrapPanel Margin="-10,4,0,0"><Button Content="سجل التغييرات" Style="{StaticResource LinkButton}" Click="ChangelogClick"/><Button Content="حفظ تقرير المشكلة في ملف…" Style="{StaticResource LinkButton}" Click="SaveReportClick"/><TextBlock Text="الخطوط: Noto Kufi Arabic وAlmarai (رخصة SIL OFL)." Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="10,0"/></WrapPanel>
    <TextBlock x:Name="ToolStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
</Border>

<StackPanel Visibility="{Binding DetailsOpen,Converter={StaticResource NotVisibility}}">
<!-- Home: numbered picks, continue watching, rows -->
<StackPanel Visibility="{Binding IsHome,Converter={StaticResource BoolVisibility}}">
  <ItemsControl x:Name="PicksList" ItemsSource="{Binding Picks}" Margin="0,34,0,0">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
      <Button Padding="0" Margin="0,0,24,0" Background="Transparent" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding DisplayTitle}">
        <Border BorderBrush="{StaticResource Numeral}" BorderThickness="0,3,0,0" Padding="0,14,0,0">
          <DockPanel>
            <TextBlock FontFamily="{StaticResource Display}" FontSize="44" Foreground="{StaticResource Numeral}" DockPanel.Dock="Right" Margin="0,0,0,0" FlowDirection="LeftToRight" VerticalAlignment="Top">
              <TextBlock.Text><MultiBinding Converter="{StaticResource Rank}"><Binding/><Binding Path="ItemsSource" ElementName="PicksList"/></MultiBinding></TextBlock.Text>
            </TextBlock>
            <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MetaLine}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          </DockPanel>
        </Border>
      </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <StackPanel Visibility="{Binding HasContinueWatching,Converter={StaticResource BoolVisibility}}" Margin="0,44,0,0">
    <DockPanel Margin="0,0,0,18"><Button Content="عرض الكل" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="history"/><TextBlock Text="تابع المشاهدة" Style="{StaticResource SectionTitle}"/></DockPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RowWheel"><ItemsControl ItemsSource="{Binding ContinueWatching}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource ContinueCard}"/></ScrollViewer>
  </StackPanel>
  <StackPanel Visibility="{Binding HasNewSince,Converter={StaticResource BoolVisibility}}" Margin="0,44,0,0">
    <TextBlock Text="جديد منذ آخر زيارة" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RowWheel"><ItemsControl ItemsSource="{Binding NewSinceRow}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource PosterCard}"/></ScrollViewer>
  </StackPanel>
  <DockPanel Margin="0,44,0,18"><Button Content="عرض الكل" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="movies"/><TextBlock Text="أفلام مميزة" Style="{StaticResource SectionTitle}"/></DockPanel>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RowWheel"><ItemsControl ItemsSource="{Binding FeaturedMovies}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource PosterCard}"/></ScrollViewer>
  <StackPanel Visibility="{Binding HasBecause,Converter={StaticResource BoolVisibility}}" Margin="0,24,0,0">
    <TextBlock Text="{Binding BecauseTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RowWheel"><ItemsControl ItemsSource="{Binding BecauseRow}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource PosterCard}"/></ScrollViewer>
  </StackPanel>
  <StackPanel Margin="0,24,0,0">
    <TextBlock Text="الأعلى تقييمًا" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RowWheel"><ItemsControl ItemsSource="{Binding TopRated}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource PosterCard}"/></ScrollViewer>
  </StackPanel>
  <StackPanel Visibility="{Binding HasSeriesRow,Converter={StaticResource BoolVisibility}}" Margin="0,24,0,0">
    <DockPanel Margin="0,0,0,18"><Button Content="عرض الكل" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="series"/><TextBlock Text="أحدث المسلسلات" Style="{StaticResource SectionTitle}"/></DockPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RowWheel"><ItemsControl ItemsSource="{Binding LatestSeries}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource PosterCard}"/></ScrollViewer>
  </StackPanel>
</StackPanel>

<!-- Genre page -->
<ItemsControl ItemsSource="{Binding GenreRows}" Visibility="{Binding IsGenres,Converter={StaticResource BoolVisibility}}" Margin="0,30,0,0">
  <ItemsControl.ItemTemplate><DataTemplate>
    <StackPanel Margin="0,0,0,26">
      <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="RowWheel"><ItemsControl ItemsSource="{Binding Items}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource PosterCard}"/></ScrollViewer>
    </StackPanel>
  </DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
<Button Content="🔔 نبّهني بالنتائج الجديدة لهذا البحث" Style="{StaticResource LinkButton}" Click="SaveSearchClick" HorizontalAlignment="Right" Margin="-10,30,0,0" Visibility="{Binding CanSaveSearch,Converter={StaticResource BoolVisibility}}"/>
<!-- Section grid -->
<DockPanel Margin="0,44,0,8"><TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}"/></DockPanel>
<WrapPanel Margin="0,0,0,10" Visibility="{Binding IsLibrary,Converter={StaticResource BoolVisibility}}">
  <TextBlock Text="{Binding LibraryStats}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
  <ComboBox SelectedIndex="{Binding LibrarySort}" MinWidth="150" AutomationProperties.Name="ترتيب المكتبة"><ComboBoxItem Content="حسب المسلسل"/><ComboBoxItem Content="الأحدث إضافة"/><ComboBoxItem Content="الأكبر حجمًا"/><ComboBoxItem Content="آخر مشاهدة"/></ComboBox>
  <CheckBox Content="غير المُشاهَد فقط" IsChecked="{Binding UnwatchedOnly}" Margin="12,8,4,8"/>
  <Button Content="استيراد ملفات فيديو" Style="{StaticResource LinkButton}" Click="ImportVideosClick"/>
  <Button Content="تصدير CSV" Style="{StaticResource LinkButton}" Click="ExportCsvClick"/>
  <Button Content="نقل المكتبة إلى قرص آخر" Style="{StaticResource LinkButton}" Click="MoveLibraryClick"/>
</WrapPanel>
<WrapPanel Margin="0,0,0,10" Visibility="{Binding IsFavorites,Converter={StaticResource BoolVisibility}}">
  <TextBlock Text="القائمة" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
  <ComboBox ItemsSource="{Binding ListNames}" SelectedItem="{Binding ActiveList}" MinWidth="170" AutomationProperties.Name="القائمة"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding}"/><Style.Triggers><DataTrigger Binding="{Binding}" Value=""><Setter Property="Text" Value="المفضلة"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
</WrapPanel>
<WrapPanel Margin="0,0,0,22">
  <ComboBox ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" AutomationProperties.Name="التصنيف"/>
  <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" AutomationProperties.Name="السنة"/>
  <ComboBox SelectedIndex="{Binding RatingIndex}" AutomationProperties.Name="الحد الأدنى للتقييم"><ComboBoxItem Content="كل التقييمات"/><ComboBoxItem Content="6 فأعلى"/><ComboBoxItem Content="7 فأعلى"/><ComboBoxItem Content="8 فأعلى"/></ComboBox>
  <ComboBox SelectedIndex="{Binding SortIndex}" AutomationProperties.Name="الترتيب"><ComboBoxItem Content="ترتيب الخدمة"/><ComboBoxItem Content="الأعلى تقييمًا"/><ComboBoxItem Content="الأحدث سنةً"/><ComboBoxItem Content="الاسم"/></ComboBox>
  <Button Content="مسح الفلاتر" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Command="{Binding ResetFiltersCommand}" VerticalAlignment="Center"/>
</WrapPanel>
<Grid Margin="0,0,0,20"><ItemsControl ItemsSource="{Binding MoviesView}" x:Name="Catalog" ItemTemplate="{StaticResource PosterCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
  <!-- "My library" groups episodes under their series -->
  <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,12" Margin="0,8,0,0"><StackPanel><TextBlock FontFamily="{StaticResource Display}" FontSize="24"><Run Text="{Binding Name,Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding ItemCount,Mode=OneWay}" Foreground="{StaticResource Numeral}" FontSize="18"/></TextBlock><TextBlock Text="{Binding Items,Converter={StaticResource GroupSummary}}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
  </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle>
</ItemsControl>
<!-- Skeleton cards while a page loads -->
<ItemsControl ItemsSource="{Binding SkeletonCards}" Background="{StaticResource Ground}" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False" VerticalAlignment="Top">
  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
  <ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="{Binding DataContext.CardWidth,RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,24,26">
    <Border Height="{Binding DataContext.CardWidth,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource PosterHeight}}" Background="{StaticResource Surface}"/>
    <Border Height="14" Background="{StaticResource Surface}" Margin="0,14,30,0"/><Border Height="10" Background="{StaticResource Panel}" Margin="0,8,70,0"/>
  </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
<StackPanel MinHeight="180" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}"><TextBlock Text="لا توجد عناوين لعرضها" FontFamily="{StaticResource Display}" FontSize="26"/><TextBlock Text="جرّب بحثًا آخر أو امسح الفلاتر." Foreground="{StaticResource Muted}" Margin="0,12"/><Button Content="إعادة المحاولة" Style="{StaticResource GhostButton}" Padding="20,10" Command="{Binding RefreshCommand}" HorizontalAlignment="Center"/></StackPanel>
</Grid></StackPanel></StackPanel></ScrollViewer>

<!-- Download bar: big percent, title, thin amber line, size, actions -->
<Border x:Name="DownloadDock" Grid.Row="1" Margin="56,6" Padding="0,14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Visibility="{Binding HasDockItem,Converter={StaticResource BoolVisibility}}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBlock FontFamily="{StaticResource Display}" FontSize="30" Foreground="{StaticResource Accent}" Width="90" VerticalAlignment="Center" FlowDirection="LeftToRight" TextAlignment="Right" Text="{Binding DockItem.Percent,StringFormat={}{0:0}%}"/>
  <Button AutomationProperties.Name="فتح قائمة التنزيلات" Grid.Column="1" Background="Transparent" Padding="18,0" Click="OpenDownloadsClick" ToolTip="فتح قائمة التنزيلات" MaxWidth="320" HorizontalContentAlignment="Right">
    <StackPanel><TextBlock Text="{Binding DockItem.Title}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"><Run Text="{Binding DockItem.QualityLabel,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DockItem.StatusLabel,Mode=OneWay}"/></TextBlock></StackPanel>
  </Button>
  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
    <ProgressBar Value="{Binding DockItem.Percent,Mode=OneWay,FallbackValue=0}" IsIndeterminate="{Binding DockItem.Indeterminate,Mode=OneWay,FallbackValue=False}" Height="3" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
    <DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding DockItem.SizeLabel}" Foreground="{StaticResource Body}" FontSize="13" FlowDirection="LeftToRight" DockPanel.Dock="Left"/><TextBlock Text="{Binding DockItem.RateLine}" Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Right"/></DockPanel>
  </StackPanel>
  <Button Grid.Column="3" Style="{StaticResource LinkButton}" Command="{Binding ToggleCommand}" CommandParameter="{Binding DockItem}" Margin="16,0">
    <TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="متابعة"/><Style.Triggers><DataTrigger Binding="{Binding DockItem.CanPause}" Value="True"><Setter Property="Text" Value="إيقاف"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Button>
  <Button Grid.Column="4" Content="إلغاء" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Command="{Binding CancelCommand}" CommandParameter="{Binding DockItem}" IsEnabled="{Binding DockItem.CanCancel,FallbackValue=False}"/>
</Grid></Border>

<DockPanel Grid.Row="2" Margin="56,2,56,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="السابق" Style="{StaticResource LinkButton}" Command="{Binding PreviousCommand}"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource Muted}"/><Button Content="التالي" Style="{StaticResource LinkButton}" Command="{Binding NextCommand}"/></StackPanel><Button Content="تحديث ↻" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Command="{Binding RefreshCommand}" DockPanel.Dock="Right"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Faint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" Margin="5,0"/></DockPanel>
<!-- Undo strip after deleting from My library -->
<Border x:Name="UndoBar" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,90" Padding="18,10" Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,3" Visibility="Collapsed" Panel.ZIndex="5">
  <StackPanel Orientation="Horizontal"><TextBlock x:Name="UndoText" VerticalAlignment="Center"/><Button Content="تراجع" Style="{StaticResource LinkButton}" Click="UndoClick"/></StackPanel>
</Border>
</Grid>
<!-- First-run tour -->
<Border x:Name="Tour" Grid.RowSpan="2" Panel.ZIndex="20" Background="#D90E1222" Visibility="Collapsed">
  <Border Width="560" Padding="34" Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="0,4,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
    <StackPanel>
      <TextBlock x:Name="TourStep" Foreground="{StaticResource Accent}"/>
      <TextBlock x:Name="TourTitle" FontFamily="{StaticResource Display}" FontSize="30" Margin="0,8,0,10" TextWrapping="Wrap"/>
      <TextBlock x:Name="TourText" TextWrapping="Wrap" LineHeight="26" FontSize="15" Foreground="{StaticResource Body}"/>
      <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button x:Name="TourNext" Content="التالي" Style="{StaticResource PrimaryButton}" Padding="26,10" Click="TourNextClick"/><Button Content="تخطّي" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Click="TourSkipClick"/></StackPanel>
    </StackPanel>
  </Border>
</Border>
<Border x:Name="PlayerHost" Grid.RowSpan="2" Panel.ZIndex="10" Background="#08090B" Visibility="Collapsed"/>
</Grid></Window>
