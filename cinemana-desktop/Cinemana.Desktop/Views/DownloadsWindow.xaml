<Window x:Class="Cinemana.Desktop.Views.DownloadsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="سينمانا | التنزيلات" Width="1060" Height="780" MinWidth="820" MinHeight="590" Background="{StaticResource Ground}" Foreground="{StaticResource Ink}" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
  <Grid Margin="40,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- Big title and three stat blocks -->
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Bottom"><TextBlock Text="التنزيلات" FontFamily="{StaticResource Display}" FontSize="56"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
      <UniformGrid Grid.Column="1" Rows="1" VerticalAlignment="Bottom">
        <Border BorderBrush="{StaticResource Accent}" BorderThickness="0,3,0,0" Padding="0,10,0,0" Margin="0,0,20,0"><StackPanel><TextBlock Text="{Binding RemainingLabel}" FontFamily="{StaticResource Display}" FontSize="30" FlowDirection="LeftToRight" HorizontalAlignment="Right"/><TextBlock Text="المتبقي" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        <Border BorderBrush="{StaticResource Numeral}" BorderThickness="0,3,0,0" Padding="0,10,0,0" Margin="0,0,20,0"><StackPanel><TextBlock Text="{Binding EtaLabel}" FontFamily="{StaticResource Display}" FontSize="30"/><TextBlock Text="الوقت المتوقع" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        <Border BorderBrush="{StaticResource Numeral}" BorderThickness="0,3,0,0" Padding="0,10,0,0"><StackPanel><TextBlock Text="{Binding RunningLabel}" FontFamily="{StaticResource Display}" FontSize="30" FlowDirection="LeftToRight" HorizontalAlignment="Right"/><TextBlock Text="جارية من القائمة" Foreground="{StaticResource Muted}"/></StackPanel></Border>
      </UniformGrid>
    </Grid>
    <!-- New download plan -->
    <Border x:Name="PlanPanel" Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="0,18" Margin="0,24,0,8"><StackPanel>
      <TextBlock x:Name="TargetLabel" FontFamily="{StaticResource Display}" FontSize="24" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,12,0,4">
        <TextBlock Text="المحتوى" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ComboBox x:Name="Scope" SelectedIndex="0" SelectionChanged="SelectionChanged" MinWidth="230" AutomationProperties.Name="نطاق التنزيل"><ComboBoxItem Content="الفيلم / الحلقة المحددة" Tag="0"/><ComboBoxItem x:Name="SeasonScope" Content="الموسم المحدد" Tag="1"/><ComboBoxItem x:Name="SeriesScope" Content="المسلسل كاملًا • كل المواسم" Tag="2"/></ComboBox>
        <TextBlock x:Name="SeasonLabel" Text="الموسم" VerticalAlignment="Center" Margin="12,0,2,0" Foreground="{StaticResource Muted}"/><ComboBox x:Name="Season" MinWidth="65" SelectionChanged="SelectionChanged" AutomationProperties.Name="موسم التنزيل"/>
        <TextBlock Text="الجودة" VerticalAlignment="Center" Margin="12,0,2,0" Foreground="{StaticResource Muted}"/><ComboBox x:Name="Quality" MinWidth="180" SelectionChanged="SelectionChanged" AutomationProperties.Name="جودة التنزيل"/>
        <TextBlock Text="الترجمة" VerticalAlignment="Center" Margin="12,0,2,0" Foreground="{StaticResource Muted}"/><ComboBox x:Name="SubtitleLanguage" MinWidth="130" SelectedIndex="0" SelectionChanged="SelectionChanged" AutomationProperties.Name="لغة ملف الترجمة"><ComboBoxItem Content="العربية" Tag="ar"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="بدون ترجمة" Tag=""/></ComboBox>
      </WrapPanel>
      <TextBlock Text="الترجمة تُحفظ بجانب كل حلقة كملف .srt بنفس الاسم فيعرضها المشغّل تلقائيًا." Foreground="{StaticResource Muted}" Margin="2,4" TextWrapping="Wrap"/>
      <DockPanel Margin="0,8"><Button x:Name="FolderButton" Content="اختيار المجلد" Style="{StaticResource LinkButton}" Click="ChooseFolder" DockPanel.Dock="Left"/><TextBlock Text="{Binding Directory}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" VerticalAlignment="Center" Foreground="#C9CCDA" Margin="6"/></DockPanel>
      <WrapPanel><Button x:Name="PrepareButton" Content="معاينة ملفات التنزيل" Style="{StaticResource GhostButton}" Padding="20,12" Margin="0,0,12,0" Click="PrepareClick"/><Button x:Name="StartButton" Content="بدء التنزيل" Style="{StaticResource PrimaryButton}" Padding="24,12" Margin="0,0,12,0" Click="StartClick" IsEnabled="False"/><Button x:Name="CancelPlanButton" Content="إلغاء المعاينة" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Click="CancelPlanClick" IsEnabled="False"/></WrapPanel>
      <TextBlock x:Name="PlanStatus" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <!-- Queue -->
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <WrapPanel Margin="0,8,0,8"><Button Content="إيقاف الكل" Style="{StaticResource LinkButton}" Command="{Binding PauseAllCommand}"/><Button Content="متابعة المتوقف" Style="{StaticResource LinkButton}" Command="{Binding ResumeAllCommand}"/><Button Content="فتح المجلد" Style="{StaticResource LinkButton}" Command="{Binding FolderCommand}"/><TextBlock Text="{Binding TotalsLabel}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0"/></WrapPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Percent,StringFormat={}{0:0}%}" FontFamily="{StaticResource Display}" FontSize="26" FlowDirection="LeftToRight" TextAlignment="Right" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Numeral}"/><Style.Triggers><DataTrigger Binding="{Binding CanPause}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <StackPanel Grid.Column="1" Margin="14,0">
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="17" TextTrimming="CharacterEllipsis"/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"><Run Text="{Binding QualityLabel,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StatusLabel,Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding RateLine,Mode=OneWay}"/></TextBlock>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding Destination}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Right" ToolTip="{Binding Destination}" Foreground="#6E7491" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <ProgressBar Height="3" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding Indeterminate,Mode=OneWay}" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
                <TextBlock Text="{Binding SizeLabel}" FlowDirection="LeftToRight" HorizontalAlignment="Right" Foreground="#C9CCDA" FontSize="12" Margin="0,6,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Content="إيقاف" Style="{StaticResource LinkButton}" IsEnabled="{Binding CanPause}" Command="{Binding DataContext.PauseCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <Button Content="متابعة" Style="{StaticResource LinkButton}" IsEnabled="{Binding CanResume}" Command="{Binding DataContext.ResumeCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <Button Content="إلغاء" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" IsEnabled="{Binding CanCancel}" Command="{Binding DataContext.CancelCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <Button Content="المجلد" Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" Command="{Binding DataContext.FolderCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#6E7491" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </Grid>
</Window>
