<Window x:Class="Cinemana.Desktop.Views.DownloadsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="سينمانا | التنزيلات" Width="1060" Height="780" MinWidth="820" MinHeight="590" Background="#090A0C" Foreground="#EDF1FA" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="التنزيلات" FontSize="28" FontWeight="SemiBold"/><TextBlock Margin="20,0,0,0" Text="{Binding Summary}" Foreground="#A8B7D0" VerticalAlignment="Center" HorizontalAlignment="Left"/></DockPanel>
    <Border x:Name="PlanPanel" Grid.Row="1" Background="#15161B" CornerRadius="12" Padding="16" Margin="0,16"><StackPanel>
      <TextBlock x:Name="TargetLabel" FontSize="20" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,12,0,4">
        <TextBlock Text="المحتوى" VerticalAlignment="Center"/><ComboBox x:Name="Scope" SelectedIndex="0" SelectionChanged="SelectionChanged" MinWidth="230" AutomationProperties.Name="نطاق التنزيل"><ComboBoxItem Content="الفيلم / الحلقة المحددة" Tag="0"/><ComboBoxItem x:Name="SeasonScope" Content="الموسم المحدد" Tag="1"/><ComboBoxItem x:Name="SeriesScope" Content="المسلسل كاملًا • كل المواسم" Tag="2"/></ComboBox>
        <TextBlock x:Name="SeasonLabel" Text="الموسم" VerticalAlignment="Center" Margin="12,0,2,0"/><ComboBox x:Name="Season" MinWidth="65" SelectionChanged="SelectionChanged" AutomationProperties.Name="موسم التنزيل"/>
        <TextBlock Text="الجودة" VerticalAlignment="Center" Margin="12,0,2,0"/><ComboBox x:Name="Quality" MinWidth="180" SelectionChanged="SelectionChanged" AutomationProperties.Name="جودة التنزيل"/>
        <TextBlock Text="الترجمة" VerticalAlignment="Center" Margin="12,0,2,0"/><ComboBox x:Name="SubtitleLanguage" MinWidth="130" SelectedIndex="0" SelectionChanged="SelectionChanged" AutomationProperties.Name="لغة ملف الترجمة"><ComboBoxItem Content="العربية" Tag="ar"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="بدون ترجمة" Tag=""/></ComboBox>
      </WrapPanel>
      <TextBlock Text="جميع الجودات: ملف مستقل لكل جودة متاحة في كل حلقة. الترجمة تُحفظ بجانب كل حلقة كملف .srt بنفس الاسم فيعرضها المشغّل تلقائيًا." Foreground="#9DADC6" Margin="2,4" TextWrapping="Wrap"/>
      <DockPanel Margin="0,8"><Button x:Name="FolderButton" Content="اختيار المجلد" Click="ChooseFolder" DockPanel.Dock="Left"/><TextBlock Text="{Binding Directory}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" VerticalAlignment="Center" Foreground="#B4C2D8" Margin="6"/></DockPanel>
      <WrapPanel><Button x:Name="PrepareButton" Content="معاينة ملفات التنزيل" Click="PrepareClick"/><Button x:Name="StartButton" Content="بدء التنزيل" Click="StartClick" IsEnabled="False" Background="#E50932"/><Button x:Name="CancelPlanButton" Content="إلغاء المعاينة" Click="CancelPlanClick" IsEnabled="False"/></WrapPanel>
      <TextBlock x:Name="PlanStatus" Foreground="#E4C286" TextWrapping="Wrap" Margin="4,9,4,0"/>
    </StackPanel></Border>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,10"><Button Content="إيقاف الكل مؤقتًا" Command="{Binding PauseAllCommand}"/><Button Content="متابعة المتوقف" Command="{Binding ResumeAllCommand}"/><Button Content="فتح مجلد التنزيل" Command="{Binding FolderCommand}"/><TextBlock Text="تُنزل الملفات بالتتابع. يمكنك إغلاق هذه النافذة ومتابعة استخدام التطبيق." Foreground="#98A9C4" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0"/></WrapPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border Background="#15161B" CornerRadius="9" Padding="14" Margin="0,0,0,9"><StackPanel>
        <DockPanel><TextBlock Text="{Binding QualityLabel}" DockPanel.Dock="Left" Foreground="#FFD37A" Margin="12,0"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/></DockPanel>
        <ProgressBar Height="5" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Margin="0,12,0,6" Foreground="#E50932"/>
        <DockPanel><TextBlock Text="{Binding StatusLabel}" Foreground="#BDCADF"/><TextBlock Text="{Binding ProgressLabel}" FlowDirection="LeftToRight" Foreground="#9DADC6" HorizontalAlignment="Left"/></DockPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#DFBD8A" Margin="0,5"/><TextBlock Text="{Binding Destination}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" ToolTip="{Binding Destination}" Foreground="#6F86A8" FontSize="11"/>
        <WrapPanel><Button Content="إيقاف مؤقت" IsEnabled="{Binding CanPause}" Command="{Binding DataContext.PauseCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,6"/><Button Content="متابعة / إعادة المحاولة" IsEnabled="{Binding CanResume}" Command="{Binding DataContext.ResumeCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,6"/><Button Content="إلغاء" IsEnabled="{Binding CanCancel}" Command="{Binding DataContext.CancelCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,6"/><Button Content="فتح المجلد" Command="{Binding DataContext.FolderCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,6"/></WrapPanel>
      </StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#9BACCA" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </Grid>
</Window>

