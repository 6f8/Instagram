<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Cinemana.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <SolidColorBrush x:Key="Accent" Color="#E50932" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="#202126" />
      <Setter Property="Foreground" Value="#F2F4FA" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.78" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#E50932" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#15161B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="BorderBrush" Value="#303138" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinWidth" Value="105" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Foreground" Value="#E9EEF8" />
      <Setter Property="Background" Value="#202126" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="#202126" BorderThickness="0" Foreground="#E9EEF8">
                <Border Background="#202126" Padding="10,8" CornerRadius="7">
                  <DockPanel>
                    <TextBlock Text="⌄" DockPanel.Dock="Left" Margin="8,0" />
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" />
                  </DockPanel>
                </Border>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                <Border Background="#202126" BorderBrush="#3D3E46" BorderThickness="1" Padding="5" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="300">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Foreground" Value="#E9EEF8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#34353D" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#50101D" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E9EEF8" />
      <Setter Property="Margin" Value="4,8" />
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="Background" Value="#121317" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="5">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Background="#494B55">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DrawingImage x:Key="CinemaMark"><DrawingImage.Drawing><GeometryDrawing Brush="{StaticResource Accent}" Geometry="M 0,80 C 20,80 22,40 48,40 L 62,40 C 40,48 44,80 17,80 Z M 34,80 C 60,80 58,18 91,18 L 108,18 C 79,30 89,80 58,80 Z M 76,80 C 108,80 99,0 136,0 L 153,0 L 153,20 C 128,20 143,80 108,80 Z M 164,3 Q 164,0 168,2 L 205,24 Q 209,27 205,30 L 168,52 Q 164,54 164,50 Z"/></DrawingImage.Drawing></DrawingImage>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Padding" Value="14,15"/><Setter Property="Margin" Value="0,3"/><Setter Property="Foreground" Value="#B8BAC3"/>
      <Style.Triggers>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Section}" Value="movies"/><Condition Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="movies"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#50101D"/><Setter Property="Foreground" Value="White"/></MultiDataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Section}" Value="series"/><Condition Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="series"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#50101D"/><Setter Property="Foreground" Value="White"/></MultiDataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Section}" Value="favorites"/><Condition Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="favorites"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#50101D"/><Setter Property="Foreground" Value="White"/></MultiDataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Section}" Value="history"/><Condition Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="history"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#50101D"/><Setter Property="Foreground" Value="White"/></MultiDataTrigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
